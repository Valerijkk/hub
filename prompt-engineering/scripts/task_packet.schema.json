{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task_packet.schema.json",
  "title": "Deterministic task-packet builder configuration",
  "type": "object",
  "required": [
    "schema_version",
    "builder_version",
    "paths",
    "statuses",
    "context_section_allowlist",
    "pattern_policy",
    "approval_policy",
    "source_excerpt_policy",
    "limits",
    "file_policy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "builder_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "paths": {
      "type": "object",
      "required": [
        "required_rules",
        "agents_directory",
        "recipes_directory",
        "profiles_directory",
        "approved_patterns_directory"
      ],
      "properties": {
        "required_rules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "$ref": "#/$defs/relativePath"
          },
          "uniqueItems": true
        },
        "agents_directory": {
          "$ref": "#/$defs/relativePath"
        },
        "recipes_directory": {
          "$ref": "#/$defs/relativePath"
        },
        "profiles_directory": {
          "$ref": "#/$defs/relativePath"
        },
        "approved_patterns_directory": {
          "$ref": "#/$defs/relativePath"
        }
      },
      "additionalProperties": false
    },
    "statuses": {
      "type": "object",
      "required": [
        "allowed_recipe_statuses",
        "allowed_profile_statuses",
        "allowed_scan_statuses",
        "required_pattern_status"
      ],
      "properties": {
        "allowed_recipe_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "candidate",
              "approved"
            ]
          },
          "uniqueItems": true
        },
        "allowed_profile_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "filled",
              "generated",
              "partial",
              "complete"
            ]
          },
          "uniqueItems": true
        },
        "allowed_scan_statuses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "partial",
              "complete"
            ]
          },
          "uniqueItems": true
        },
        "required_pattern_status": {
          "const": "approved"
        }
      },
      "additionalProperties": false
    },
    "context_section_allowlist": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[A-Z0-9][A-Z0-9-]*\\.md$"
      },
      "uniqueItems": true
    },
    "pattern_policy": {
      "type": "object",
      "required": [
        "allowed_reuse_scopes",
        "portable_profile_markers"
      ],
      "properties": {
        "allowed_reuse_scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "project-only",
              "organization",
              "portable"
            ]
          },
          "uniqueItems": true
        },
        "portable_profile_markers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "approval_policy": {
      "type": "object",
      "required": [
        "allowed_action_kinds",
        "required_tool",
        "required_destination",
        "human_reference_prefixes",
        "policy_reference_prefixes"
      ],
      "properties": {
        "allowed_action_kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "read",
              "write",
              "command",
              "network",
              "external-write",
              "destructive",
              "provider-route"
            ]
          },
          "uniqueItems": true
        },
        "required_tool": {
          "const": "local-agent"
        },
        "required_destination": {
          "const": "local"
        },
        "human_reference_prefixes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "policy_reference_prefixes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      },
      "additionalProperties": false
    },
    "source_excerpt_policy": {
      "type": "object",
      "required": [
        "denied_directory_names",
        "denied_name_prefixes",
        "denied_extensions",
        "denied_project_relative_prefixes"
      ],
      "properties": {
        "denied_directory_names": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "denied_name_prefixes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "denied_extensions": {
          "$ref": "#/$defs/nonEmptyStringArray"
        },
        "denied_project_relative_prefixes": {
          "$ref": "#/$defs/nonEmptyStringArray"
        }
      },
      "additionalProperties": false
    },
    "limits": {
      "type": "object",
      "required": [
        "max_packet_bytes",
        "max_context_sections",
        "max_patterns",
        "max_source_excerpts"
      ],
      "properties": {
        "max_packet_bytes": {
          "type": "integer",
          "minimum": 4096
        },
        "max_context_sections": {
          "type": "integer",
          "minimum": 1
        },
        "max_patterns": {
          "type": "integer",
          "minimum": 1
        },
        "max_source_excerpts": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "file_policy": {
      "type": "object",
      "required": [
        "allowed_text_extensions",
        "allowed_text_names",
        "max_file_bytes",
        "max_total_bytes",
        "max_file_count"
      ],
      "properties": {
        "allowed_text_extensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^\\.[a-z0-9]+$"
          },
          "uniqueItems": true
        },
        "allowed_text_names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "max_file_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_total_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_file_count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)[^\\\\\\u0000]+$"
    },
    "nonEmptyStringArray": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
