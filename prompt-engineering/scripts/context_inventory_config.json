{
  "schema_version": 1,
  "file_policy": {
    "allowed_text_extensions": [
      ".bat",
      ".c",
      ".cc",
      ".cfg",
      ".cjs",
      ".cmd",
      ".conf",
      ".cpp",
      ".cs",
      ".css",
      ".go",
      ".graphql",
      ".h",
      ".hpp",
      ".html",
      ".ini",
      ".java",
      ".js",
      ".json",
      ".jsx",
      ".kt",
      ".kts",
      ".md",
      ".mdc",
      ".mjs",
      ".mod",
      ".php",
      ".properties",
      ".proto",
      ".ps1",
      ".py",
      ".rb",
      ".rs",
      ".scss",
      ".sh",
      ".sql",
      ".sum",
      ".swift",
      ".toml",
      ".ts",
      ".tsx",
      ".txt",
      ".vue",
      ".xml",
      ".yaml",
      ".yml"
    ],
    "allowed_text_names": [
      ".dockerignore",
      ".editorconfig",
      ".gitattributes",
      ".gitignore",
      "Dockerfile",
      "LICENSE",
      "Makefile",
      "NOTICE"
    ],
    "max_file_bytes": 1048576,
    "max_total_bytes": 67108864,
    "max_file_count": 20000
  },
  "exclude_directory_names": [
    ".git",
    ".hg",
    ".svn",
    ".cache",
    ".coverage",
    ".mypy_cache",
    ".nox",
    ".pytest_cache",
    ".ruff_cache",
    ".tox",
    ".venv",
    "__pycache__",
    "build",
    "coverage",
    "dist",
    "htmlcov",
    "node_modules",
    "playwright-report",
    "target",
    "third_party",
    "traces",
    "vendor",
    "venv"
  ],
  "exclude_globs": [
    "**/.env",
    "**/.env.*",
    "**/*.min.js",
    "**/*.min.css",
    "**/credentials.json",
    "**/credentials.*",
    "**/id_rsa",
    "**/id_ed25519",
    "**/*.key",
    "**/*.p12",
    "**/*.pem",
    "**/*.pfx",
    "**/secrets",
    "**/secrets/**",
    "prompt-engineering/context/**",
    "prompt-engineering/patterns/**",
    "prompt-engineering/review-feedback/**"
  ]
}
