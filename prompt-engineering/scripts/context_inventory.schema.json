{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "context_inventory.schema.json",
  "title": "Mechanical context inventory",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "policy_sha256",
    "roots",
    "files",
    "exclusions",
    "file_count",
    "total_bytes",
    "inventory_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "generated_at": {
      "type": "string"
    },
    "policy_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "roots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "path"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "root_id",
          "path",
          "sha256",
          "size_bytes",
          "modified_at"
        ],
        "properties": {
          "root_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "modified_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "root_id",
          "path",
          "reason"
        ],
        "properties": {
          "root_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "reason": {
            "enum": [
              "configured-directory",
              "configured-path",
              "binary-or-non-utf8",
              "oversized-file",
              "unapproved-file-type"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "inventory_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "additionalProperties": false
}
