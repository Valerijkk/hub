{
  "schema_version": 1,
  "scan": {
    "global_exclude_globs": [
      "**/__pycache__",
      "**/__pycache__/**",
      "**/*.pyc",
      "**/.pytest_cache",
      "**/.pytest_cache/**"
    ],
    "file_policy": {
      "allowed_text_extensions": [
        ".json",
        ".md",
        ".mdc",
        ".py",
        ".txt",
        ".yaml",
        ".yml"
      ],
      "allowed_text_names": [
        ".gitignore",
        "LICENSE",
        "NOTICE"
      ],
      "max_file_bytes": 2097152,
      "max_total_bytes": 67108864,
      "max_file_count": 5000
    }
  },
  "links": {
    "include_globs": [
      "**/*.md"
    ],
    "exclude_globs": []
  },
  "frontmatter": {
    "include_globs": [
      "**/*.md"
    ],
    "exclude_globs": [],
    "required_globs": [
      "MANIFEST.md",
      "VERSION.md",
      "skills/**/SKILL.md",
      "evals/fixtures/*.md"
    ]
  },
  "skills": {
    "include_globs": [
      "skills/**/SKILL.md"
    ],
    "exclude_globs": [],
    "required_fields": [
      "name",
      "description"
    ],
    "name_pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "name_max_length": 64,
    "description_max_length": 1024
  },
  "prompt_ids": {
    "include_globs": [
      "prompts/[0-9][0-9]-*.md"
    ],
    "exclude_globs": [],
    "line_pattern": "^\\s*(?P<id>[0-9]+)\\.\\s+\\S",
    "expected_start": 1
  },
  "placeholders": {
    "profile_globs": [
      "context/*.md"
    ],
    "exclude_globs": [
      "context/README.md"
    ],
    "placeholder_pattern": "\\{\\{[^{}\\r\\n]+\\}\\}",
    "status_field": "status",
    "template_statuses": [
      "template"
    ],
    "generated_statuses": [
      "filled",
      "generated"
    ],
    "template_requires_placeholder": true,
    "generated_required_fields": [
      "filled_by",
      "filled_at",
      "provenance",
      "source_revision"
    ],
    "context_manifest": {
      "path": "context/CONTEXT-MANIFEST.md",
      "required_when_profiles_generated": true,
      "required_fields": [
        "manifest_version",
        "status",
        "generated_at",
        "generated_by",
        "source_revision",
        "provenance"
      ]
    },
    "structured_profiles": {
      "template_directories": [
        "context/templates"
      ],
      "projects_root": "context/projects",
      "excluded_project_directories": [],
      "manifest_name": "CONTEXT-MANIFEST.yaml",
      "manifest_status_path": "profile.status",
      "manifest_slug_path": "profile.slug",
      "template_status": "template",
      "generated_statuses": [
        "filled",
        "generated",
        "partial",
        "complete"
      ],
      "manifest_required_paths": [
        "schema_version",
        "profile.slug",
        "profile.project_name",
        "profile.status",
        "inputs.project_root",
        "inputs.test_roots",
        "scan.mode",
        "scan.status",
        "scan.generated_at",
        "scan.snapshot_commit",
        "scan.trust_boundary",
        "scan.network_used",
        "scan.merge_request_data_used",
        "scan.metadata_commands_executed",
        "scan.project_commands_executed",
        "policy.filesystem_scope",
        "policy.follow_symlinks",
        "policy.source_mutation_allowed",
        "policy.command_execution_requires_explicit_approval",
        "sources[].id",
        "sources[].root",
        "sources[].path",
        "sources[].kind",
        "sources[].sha256",
        "sources[].size_bytes",
        "sources[].modified_at",
        "sources[].observed_at",
        "outputs[].path",
        "outputs[].status",
        "outputs[].sha256",
        "incremental.previous_manifest_sha256",
        "unknowns"
      ],
      "expected_markdown_files": [
        "PROJECT.md",
        "TEST-ARCHITECTURE.md",
        "COMMANDS.md",
        "CI-PIPELINE.md",
        "TEST-DATA.md",
        "TRACEABILITY.md",
        "SOURCE-MAP.md",
        "PATTERN-INDEX.md"
      ],
      "ignored_markdown_files": [
        "README.md"
      ],
      "markdown_required_fields": [
        "context_schema",
        "profile_slug",
        "status",
        "generated_at",
        "snapshot_commit"
      ],
      "markdown_status_field": "status",
      "markdown_slug_field": "profile_slug"
    }
  },
  "cot_disclosure": {
    "include_globs": [
      "agents/**/*.md",
      "skills/**/*.md",
      "rules/**/*.md",
      "playbooks/**/*.md",
      "prompts/**/*.md"
    ],
    "exclude_globs": [],
    "negation_prefix_patterns": [
      "(?i)\\b(?:do\\s+not|don't|never|must\\s+not|should\\s+not|cannot|can't)\\b.{0,24}$",
      "(?i)\\b(?:не|нельзя|запрещено)\\b.{0,24}$"
    ],
    "patterns": [
      {
        "id": "en-show-chain-of-thought",
        "regex": "(?i)\\b(?:show|reveal|provide|print|write\\s+out|expose)\\b.{0,60}\\b(?:chain[- ]of[- ]thought|internal reasoning|hidden reasoning|private reasoning)\\b"
      },
      {
        "id": "en-step-by-step-disclosure",
        "regex": "(?i)\\bthink\\s+step[- ]by[- ]step\\b.{0,40}\\b(?:show|reveal|print|share)\\b"
      },
      {
        "id": "en-explain-reasoning-stepwise",
        "regex": "(?i)\\b(?:explain|share|detail|document)\\b.{0,50}\\b(?:your\\s+)?(?:reasoning|thought\\s+process)\\b.{0,30}\\b(?:step[- ]by[- ]step|in\\s+full|in\\s+detail)\\b"
      },
      {
        "id": "ru-show-internal-reasoning",
        "regex": "(?i)\\b(?:покажи|раскрой|выведи|напиши|опиши)\\b.{0,60}\\b(?:пошагов\\w*\\s+рассужден\\w*|внутренн\\w*\\s+рассужден\\w*|скрыт\\w*\\s+рассужден\\w*|цепочк\\w*\\s+рассужден\\w*)\\b"
      },
      {
        "id": "ru-explain-reasoning-stepwise",
        "regex": "(?i)\\b(?:объясни|распиши|покажи)\\b.{0,40}\\b(?:ход\\s+мыслей|ход\\s+рассуждений|рассуждения)\\b.{0,30}\\b(?:пошагово|подробно)\\b"
      }
    ]
  },
  "gsd_routes": {
    "include_globs": [
      "**/*.md"
    ],
    "exclude_globs": [],
    "route_patterns": [
      "(?<![\\w.-])/(?P<route>gsd-[a-z0-9][a-z0-9_-]*)\\b",
      "(?i)\\b(?:route|command)\\s*[:=]\\s*`?/?(?P<route>gsd-[a-z0-9][a-z0-9_-]*)\\b"
    ],
    "known_routes": [
      "gsd-add-backlog",
      "gsd-add-phase",
      "gsd-add-tests",
      "gsd-add-todo",
      "gsd-ai-integration-phase",
      "gsd-analyze-dependencies",
      "gsd-audit-fix",
      "gsd-audit-milestone",
      "gsd-audit-uat",
      "gsd-autonomous",
      "gsd-check-todos",
      "gsd-cleanup",
      "gsd-code-review",
      "gsd-code-review-fix",
      "gsd-complete-milestone",
      "gsd-debug",
      "gsd-discuss-phase",
      "gsd-do",
      "gsd-docs-update",
      "gsd-eval-review",
      "gsd-execute-phase",
      "gsd-explore",
      "gsd-extract_learnings",
      "gsd-fast",
      "gsd-forensics",
      "gsd-from-gsd2",
      "gsd-graphify",
      "gsd-health",
      "gsd-help",
      "gsd-import",
      "gsd-inbox",
      "gsd-insert-phase",
      "gsd-intel",
      "gsd-join-discord",
      "gsd-list-phase-assumptions",
      "gsd-list-workspaces",
      "gsd-manager",
      "gsd-map-codebase",
      "gsd-milestone-summary",
      "gsd-new-milestone",
      "gsd-new-project",
      "gsd-new-workspace",
      "gsd-next",
      "gsd-note",
      "gsd-pause-work",
      "gsd-plan-milestone-gaps",
      "gsd-plan-phase",
      "gsd-plant-seed",
      "gsd-pr-branch",
      "gsd-profile-user",
      "gsd-progress",
      "gsd-quick",
      "gsd-reapply-patches",
      "gsd-remove-phase",
      "gsd-remove-workspace",
      "gsd-research-phase",
      "gsd-resume-work",
      "gsd-review",
      "gsd-review-backlog",
      "gsd-scan",
      "gsd-secure-phase",
      "gsd-session-report",
      "gsd-set-profile",
      "gsd-settings",
      "gsd-ship",
      "gsd-sketch",
      "gsd-sketch-wrap-up",
      "gsd-spec-phase",
      "gsd-spike",
      "gsd-spike-wrap-up",
      "gsd-stats",
      "gsd-thread",
      "gsd-ui-phase",
      "gsd-ui-review",
      "gsd-undo",
      "gsd-update",
      "gsd-validate-phase",
      "gsd-verify-work",
      "gsd-workstreams"
    ]
  },
  "secrets": {
    "include_globs": [
      "**"
    ],
    "exclude_globs": []
  },
  "portable_leakage": {
    "include_globs": [
      "README.md",
      "INSTALL.md",
      "agents/**/*.md",
      "skills/**/*.md",
      "rules/**/*.md",
      "playbooks/**/*.md",
      "prompts/**/*.md",
      "context/*.md",
      "context/templates/**/*.md",
      "context/templates/**/*.yaml"
    ],
    "exclude_globs": [],
    "deny_patterns": [
      {
        "id": "project-name-hub",
        "regex": "(?i)\\bHub\\b"
      },
      {
        "id": "project-backend-path",
        "regex": "(?i)(?:^|[\\s`\"'])backend/internal/"
      },
      {
        "id": "project-frontend-path",
        "regex": "(?i)(?:^|[\\s`\"'])frontend/src/"
      },
      {
        "id": "project-planning-path",
        "regex": "(?i)\\.planning/(?:july-2026|production|audits)/"
      }
    ],
    "allow_rules": [
      {
        "path_globs": [
          "README.md"
        ],
        "pattern_ids": [
          "project-name-hub"
        ],
        "reason": "The distribution README labels the source-specific optional bridge."
      },
      {
        "path_globs": [
          "playbooks/portable-kit-dry-run.md"
        ],
        "pattern_ids": [
          "project-name-hub",
          "project-planning-path"
        ],
        "reason": "The migration playbook explicitly distinguishes source-only references."
      }
    ]
  },
  "trailing_whitespace": {
    "include_globs": [
      "**/*.md",
      "**/*.mdc",
      "**/*.py",
      "**/*.json",
      "**/*.yaml",
      "**/*.yml",
      "**/*.txt"
    ],
    "exclude_globs": []
  },
  "cursor_adapter": {
    "mapping_path": "adapters/cursor/agents.map.yaml",
    "wrapper_path": "adapters/cursor/wrapper.template.md",
    "core_directory": "agents",
    "required_readonly_roles": [
      "code-reviewer",
      "security-reviewer",
      "test-code-reviewer"
    ],
    "required_wrapper_tokens": [
      "name: \"{{name}}\"",
      "description: \"{{description}}\"",
      "model: inherit",
      "readonly: {{readonly}}",
      "prompt-engineering/rules/00-global-agent-rules.md",
      "prompt-engineering/rules/50-data-handling.md",
      "prompt-engineering/adapters/APPROVAL-RECORD.schema.yaml"
    ],
    "forbidden_offline_claims": [
      "runtime catalog verified",
      "data policy verified offline"
    ]
  },
  "toolkit_manifest": {
    "path": "MANIFEST.md",
    "required_fields": [
      "manifest_version",
      "toolkit_version",
      "status",
      "owner",
      "layer",
      "source_registry",
      "validation_config",
      "validation_status",
      "provenance"
    ],
    "source_registry_field": "source_registry"
  },
  "recipes": {
    "required_sections": [
      "Результат",
      "Нормализованные входы",
      "Контекст и фрагменты",
      "Инструменты и согласование",
      "Ограничения / вне scope",
      "Схема выхода",
      "Evidence / критерий завершения",
      "Стоп / спросить",
      "Обоснование",
      "Eval fixture"
    ],
    "optional_sections": [
      "Процедура",
      "Типичные ошибки"
    ]
  }
}
