# Hub — Testing Patterns

## Go Backend Tests

### Integration Tests (реальный канон Hub)

> **Важно:** Hub **не использует testcontainers-go** в реальном коде — тесты подключаются к контейнерам `deployments/docker-compose.test.yml` через переменную окружения (Postgres/Mongo уже запущены отдельно). Ниже — фактический паттерн, см. `backend/testframework/search/service_wave116_postgres_test.go`.

```go
func setupTestDB(t *testing.T) *sql.DB {
    t.Helper()
    uri := os.Getenv("POSTGRES_TEST_URL")
    if uri == "" {
        uri = "postgresql://hub:hub@postgres:5432/hub?sslmode=disable"
    }
    ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
    defer cancel()

    db, err := sql.Open("postgres", uri)
    require.NoError(t, err)
    if err := db.PingContext(ctx); err != nil {
        // Запасной вариант для локальных прогонов против опубликованного порта
        fallback := "postgresql://hub:hub@localhost:5432/hub?sslmode=disable"
        db2, err2 := sql.Open("postgres", fallback)
        require.NoError(t, err2)
        return db2
    }
    return db
}
```

Каноническая команда запуска (Docker, см. `AGENTS.md`):

```bash
docker compose -f deployments/docker-compose.test.yml up -d
docker run --rm --network deployments_default \
  -v "${PWD}/backend:/app" -w /app \
  -e POSTGRES_TEST_URL="postgresql://hub:hub@postgres:5432/hub?sslmode=disable" \
  -e MONGODB_TEST_URL="mongodb://hub:hub@mongo:27017/?authSource=admin" \
  golang:1.25-bookworm \
  sh -c "go test -tags hubtest -race -count=1 -timeout=600s ./testframework/..."
```

### Unit Tests с мок-объектами (без mockery-кодогенерации)

```go
// Hub держит тесты рядом с реальными зависимостями (httptest.NewRequest + fiber.App),
// а не через сгенерированные mockery-моки — mockery в проекте не подключён.
// Пример: backend/testframework/auth/handler_magiclink_runes_test.go

func TestVerifyMagicLink_ThreeEmojiCode_Rejected(t *testing.T) {
    h := auth.NewHandler(&auth.AuthService{})
    app := testApp(http.MethodPost, "/auth/magic-link/verify", h.VerifyMagicLink)

    resp := postVerifyMagicLink(t, app, "emoji@example.com", "🔥🔥🔥")
    defer resp.Body.Close()

    assert.Equal(t, http.StatusBadRequest, resp.StatusCode)
}
```

### Race Detector (always use)

```bash
go test -race -count=1 ./...
go test -race -run TestSpecific ./internal/module/...
```

## Frontend Tests (Vitest + RTL)

```typescript
// components/__tests__/IssueCard.test.tsx
import { render, screen } from '@testing-library/react'
import userEvent from '@testing-library/user-event'
import { IssueCard } from '../IssueCard'

describe('IssueCard', () => {
    it('renders issue title', () => {
        render(<IssueCard issue={mockIssue} />)
        expect(screen.getByText(mockIssue.title)).toBeInTheDocument()
    })

    it('calls onEdit when edit button clicked', async () => {
        const onEdit = vi.fn()
        render(<IssueCard issue={mockIssue} onEdit={onEdit} />)
        await userEvent.click(screen.getByRole('button', { name: /edit/i }))
        expect(onEdit).toHaveBeenCalledWith(mockIssue.id)
    })
})
```

