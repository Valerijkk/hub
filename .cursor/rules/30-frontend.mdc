# Hub — Frontend Patterns

## File Organization

```
frontend/src/
├── api/<module>.ts       # API client functions, one file per backend module
├── components/ui/        # Shadcn components (className-only changes allowed)
├── components/<name>/    # Feature components
├── hooks/use<Name>.ts    # Custom hooks
├── modules/<module>/     # Self-contained feature modules
│   ├── components/
│   ├── hooks/
│   └── stores/
├── routes/               # TanStack Router file-based routes
└── stores/<module>.ts    # Zustand stores
```

## TanStack Router (file-based)

```typescript
// routes/_authenticated/projects/$projectId/issues/$issueId.tsx
export const Route = createFileRoute('/_authenticated/projects/$projectId/issues/$issueId')({
    component: IssueDetailPage,
    loader: ({ params }) => issueLoader(params.issueId),
})
```

## TanStack Query Patterns

```typescript
// ✅ Good: query with proper key
const { data: issue } = useQuery({
    queryKey: ['issues', issueId],
    queryFn: () => issueApi.getById(issueId),
    staleTime: 30_000,
})

// ✅ Good: mutation with invalidation
const mutation = useMutation({
    mutationFn: issueApi.update,
    onSuccess: () => queryClient.invalidateQueries({ queryKey: ['issues'] }),
})
```

## Zustand Store Pattern

```typescript
// stores/tracker.ts
interface TrackerStore {
    selectedIssueId: string | null
    setSelectedIssue: (id: string | null) => void
}

export const useTrackerStore = create<TrackerStore>((set) => ({
    selectedIssueId: null,
    setSelectedIssue: (id) => set({ selectedIssueId: id }),
}))
```

## Design System Usage

```tsx
// ✅ CSS variables (from design system)
<div className="bg-[var(--hub-surface-raised)] border border-[var(--hub-border)]">

// ✅ Design system colors
// --hub-void, --hub-base, --hub-raised, --hub-card, --hub-input (surfaces)
// --hub-text-primary/secondary/muted/disabled (text)
// --hub-border, --hub-border-subtle, --hub-border-strong (borders)

// ✅ Shadcn: className-only changes, never modify Radix behavior
<Button className="bg-gradient-to-r from-blue-500 to-purple-500 hover:glow">

// ❌ Never inline styles over design system
<div style={{ background: '#1a1a1a' }}>  // use CSS variables instead
```

## Error Boundaries (required)

```tsx
// Wrap every major module
<ErrorBoundary fallback={<ModuleError />}>
    <TrackerModule />
</ErrorBoundary>

// Required for: calls, dashboard, tracker, TMS, messenger
```

## Lazy Loading (required for heavy deps)

```typescript
// ✅ Lazy load LiveKit, charts, editor
const CallsRoom = lazy(() => import('./modules/calls/CallsRoom'))
const Dashboard = lazy(() => import('./routes/dashboard'))
```

## API Client Pattern

```typescript
// api/tracker.ts
export const issueApi = {
    list: (projectId: string, params: IssueListParams) =>
        api.get<PaginatedResponse<Issue>>(`/projects/${projectId}/issues`, { params }),
    
    create: (projectId: string, data: CreateIssueRequest) =>
        api.post<Issue>(`/projects/${projectId}/issues`, data),
}
```
