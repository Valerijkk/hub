{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hub.example.test/schemas/mail/events-v1.schema.json",
  "title": "Hub mail, calendar and linked-call event envelope v1",
  "$comment": "COMBINED_EXACT17_ACCEPTANCE_SYNC_CANDIDATE / ATOMIC_COMMIT_REQUIRED / IMMUTABLE_EXACT_SHA_REVIEW_REQUIRED. This working tree is not authority. Calendar exact12 e60ff29934b8e53c34549cebae2e10657bae1540 and Mail correction exact9 4f92ee6b9057efccd10c0b7ac7cf7dfd0f220c71 each have Contract/Security/Lifecycle precommit and immutable exact-SHA PASS C/I/M 0/0/0. Only after one atomic exact17 acceptance-sync commit and three immutable exact-SHA PASS reviews does Calendar become SOURCE_AUTHORITY_ACCEPTED for root-only 143-03B-T exact2 dispatch and Mail correction become SOURCE_AUTHORITY_ACCEPTED for root-only frozen exact4 dispatch; all other Calendar candidate and Mail correction/suspension clauses then automatically become CONSUMED/HISTORICAL. Until then they remain current, and dirty Mail exact4 stays UNCOMMITTED / UNACCEPTED. 143-04C remains blocked until 143-03B-T source STATIC_ACCEPTED. Runtime NOT_RUN; no raw iTIP. Status metadata only; the three 100 maxima are unchanged.",
  "oneOf": [
    { "$ref": "#/$defs/mailReceived" },
    { "$ref": "#/$defs/mailSent" },
    { "$ref": "#/$defs/mailMessageChanged" },
    { "$ref": "#/$defs/calendarInviteCreated" },
    { "$ref": "#/$defs/calendarInviteUpdated" },
    { "$ref": "#/$defs/calendarInviteCancelled" },
    { "$ref": "#/$defs/calendarRsvpChanged" },
    { "$ref": "#/$defs/calendarReminderDue" },
    { "$ref": "#/$defs/callsScheduledDue" }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid"
    },
    "dateTime": {
      "type": "string",
      "format": "date-time"
    },
    "envelopeUtcZDateTime": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "Envelope occurred_at only: normalized UTC RFC 3339 date-time with terminal Z. Payload timestamps continue to use dateTime."
    },
    "email": {
      "type": "string",
      "format": "email",
      "maxLength": 320
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": ["email"],
      "properties": {
        "email": { "$ref": "#/$defs/email" },
        "name": { "type": ["string", "null"], "maxLength": 160 }
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "schema_version",
        "event_id",
        "occurred_at",
        "organization_id",
        "actor_id",
        "correlation_id",
        "payload"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "x-hub-max-utf8-bytes": 255,
          "description": "Must exactly equal OutboxEvent.event_type and the NATS subject. The shared EnvelopeV1 builder enforces the Hub 255 UTF-8-byte subject bound."
        },
        "schema_version": { "const": 1 },
        "event_id": {
          "$ref": "#/$defs/uuid",
          "description": "Stable application-event id; distinct from the outbox row id carried in Hub-Event-Id."
        },
        "occurred_at": { "$ref": "#/$defs/envelopeUtcZDateTime" },
        "organization_id": { "$ref": "#/$defs/uuid" },
        "actor_id": {
          "oneOf": [
            { "$ref": "#/$defs/uuid" },
            { "type": "null" }
          ]
        },
        "correlation_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "payload": { "type": "object" }
      }
    },
    "mailReceived": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "subject": { "const": "mail.received.v1" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mailbox_id",
                "message_id",
                "engine_message_id",
                "thread_id",
                "from",
                "to",
                "received_at",
                "folder_ids",
                "has_attachments"
              ],
              "properties": {
                "mailbox_id": { "$ref": "#/$defs/uuid" },
                "message_id": { "$ref": "#/$defs/uuid" },
                "engine_message_id": { "type": "string", "minLength": 1, "maxLength": 512 },
                "thread_id": { "$ref": "#/$defs/uuid" },
                "from": { "$ref": "#/$defs/address" },
                "to": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 200,
                  "items": { "$ref": "#/$defs/address" }
                },
                "received_at": { "$ref": "#/$defs/dateTime" },
                "folder_ids": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/uuid" }
                },
                "has_attachments": { "type": "boolean" },
                "calendar_method": {
                  "type": ["string", "null"],
                  "enum": ["request", "cancel", "reply", null]
                }
              }
            }
          }
        }
      ]
    },
    "mailSent": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "subject": { "const": "mail.sent.v1" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mailbox_id",
                "submission_id",
                "message_id",
                "thread_id",
                "from",
                "to",
                "sent_at",
                "delivery_class"
              ],
              "properties": {
                "mailbox_id": { "$ref": "#/$defs/uuid" },
                "submission_id": { "$ref": "#/$defs/uuid" },
                "message_id": { "$ref": "#/$defs/uuid" },
                "thread_id": { "$ref": "#/$defs/uuid" },
                "from": { "$ref": "#/$defs/address" },
                "to": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 200,
                  "items": { "$ref": "#/$defs/address" }
                },
                "sent_at": { "$ref": "#/$defs/dateTime" },
                "delivery_class": {
                  "type": "string",
                  "enum": ["internal", "instance_domain", "external"]
                }
              }
            }
          }
        }
      ]
    },
    "mailMessageChanged": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "subject": { "const": "mail.message.changed.v1" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": ["mailbox_id", "message_id", "changed_fields", "folder_ids", "flags", "label_ids"],
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "changed_fields": { "contains": { "const": "deleted" } }
                    },
                    "required": ["changed_fields"]
                  },
                  "then": {
                    "properties": {
                      "changed_fields": { "maxItems": 1 },
                      "folder_ids": { "maxItems": 0 },
                      "flags": { "maxItems": 0 }
                    }
                  }
                }
              ],
              "properties": {
                "mailbox_id": { "$ref": "#/$defs/uuid" },
                "message_id": { "$ref": "#/$defs/uuid" },
                "changed_fields": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 30,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": ["folder_ids", "seen", "answered", "flagged", "junk", "labels", "deleted"]
                  }
                },
                "folder_ids": {
                  "type": "array",
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/uuid" }
                },
                "flags": {
                  "type": "array",
                  "maxItems": 30,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": ["seen", "answered", "flagged", "junk", "draft"]
                  }
                },
                "label_ids": {
                  "type": "array",
                  "maxItems": 100,
                  "uniqueItems": true,
                  "items": { "$ref": "#/$defs/uuid" }
                }
              }
            }
          }
        }
      ]
    },
    "calendarInviteBasePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "uid", "sequence", "attendee_ids"],
      "properties": {
        "event_id": { "$ref": "#/$defs/uuid" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sequence": { "type": "integer", "minimum": 0 },
        "recurrence_id": { "type": ["string", "null"], "maxLength": 255 },
        "attendee_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        }
      }
    },
    "calendarInviteUpdatedPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "uid",
        "sequence",
        "attendee_ids",
        "reset_rsvp",
        "changed_fields"
      ],
      "properties": {
        "event_id": { "$ref": "#/$defs/uuid" },
        "uid": { "type": "string", "minLength": 1, "maxLength": 255 },
        "sequence": { "type": "integer", "minimum": 0 },
        "recurrence_id": { "type": ["string", "null"], "maxLength": 255 },
        "attendee_ids": {
          "type": "array",
          "maxItems": 200,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "reset_rsvp": { "type": "boolean" },
        "changed_fields": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "maxLength": 64 }
        }
      }
    },
    "calendarInviteCreated": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "subject": { "const": "calendar.invite.created.v1" },
            "payload": { "$ref": "#/$defs/calendarInviteBasePayload" }
          }
        }
      ]
    },
    "calendarInviteUpdated": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "subject": { "const": "calendar.invite.updated.v1" },
            "payload": { "$ref": "#/$defs/calendarInviteUpdatedPayload" }
          }
        }
      ]
    },
    "calendarInviteCancelled": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "subject": { "const": "calendar.invite.cancelled.v1" },
            "payload": { "$ref": "#/$defs/calendarInviteBasePayload" }
          }
        }
      ]
    },
    "calendarRsvpChanged": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "subject": { "const": "calendar.rsvp.changed.v1" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "attendee_id",
                "attendee_email",
                "previous_status",
                "new_status",
                "version",
                "reply_delivery_status"
              ],
              "properties": {
                "event_id": { "$ref": "#/$defs/uuid" },
                "attendee_id": { "$ref": "#/$defs/uuid" },
                "attendee_email": { "$ref": "#/$defs/email" },
                "previous_status": {
                  "type": "string",
                  "enum": ["needs_action", "accepted", "declined", "tentative"]
                },
                "new_status": {
                  "type": "string",
                  "enum": ["needs_action", "accepted", "declined", "tentative"]
                },
                "version": { "type": "integer", "minimum": 2 },
                "recurrence_id": { "type": ["string", "null"], "maxLength": 255 },
                "reply_delivery_status": {
                  "type": "string",
                  "enum": ["not_required", "pending", "sent", "failed"],
                  "description": "pending includes submitting or unknown reconciliation; failed is permanent only"
                }
              }
            }
          }
        }
      ]
    },
    "calendarReminderDue": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "subject": { "const": "calendar.reminder.due.v1" },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reminder_receipt_id",
                "event_id",
                "user_id",
                "sequence",
                "due_at"
              ],
              "properties": {
                "reminder_receipt_id": { "$ref": "#/$defs/uuid" },
                "event_id": { "$ref": "#/$defs/uuid" },
                "user_id": { "$ref": "#/$defs/uuid" },
                "recurrence_id": { "type": ["string", "null"], "maxLength": 255 },
                "sequence": { "type": "integer", "minimum": 0 },
                "due_at": { "$ref": "#/$defs/dateTime" }
              }
            }
          }
        }
      ]
    },
    "callsScheduledDue": {
      "x-hub-cross-field-invariants": [
        {
          "id": "CALLS_CHANNEL_SUBJECT_PAYLOAD_MATCH",
          "kind": "regex-capture-equals-json-pointer",
          "source_pointer": "/subject",
          "source_pattern": "^calls\\.channel\\.([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\\.scheduled_due\\.v1$",
          "capture_group": 1,
          "target_pointer": "/payload/channel_id",
          "normalization": "uuid-lowercase",
          "producer_failure": "reject-before-outbox",
          "consumer_failure": "dead-letter-with-zero-domain-mutation"
        }
      ],
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object",
          "properties": {
            "subject": {
              "type": "string",
              "pattern": "^calls\\.channel\\.[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\\.scheduled_due\\.v1$"
            },
            "payload": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "scheduled_call_id",
                "calendar_event_id",
                "occurrence_key",
                "recurrence_id",
                "channel_id",
                "project_id",
                "title",
                "scheduled_at",
                "duration_minutes"
              ],
              "properties": {
                "scheduled_call_id": { "$ref": "#/$defs/uuid" },
                "calendar_event_id": { "$ref": "#/$defs/uuid" },
                "occurrence_key": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "recurrence_id": { "type": ["string", "null"], "maxLength": 255 },
                "channel_id": { "$ref": "#/$defs/uuid" },
                "project_id": { "$ref": "#/$defs/uuid" },
                "title": { "type": "string", "minLength": 1, "maxLength": 255 },
                "scheduled_at": { "$ref": "#/$defs/dateTime" },
                "duration_minutes": { "type": "integer", "minimum": 1, "maximum": 1440 }
              }
            }
          }
        }
      ]
    }
  }
}
