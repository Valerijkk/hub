FROM golang@sha256:bbb255b0e131db500cf0520adc97441d2260cf629c7fa7e39e025ddf53995a24 AS backend-unit
RUN groupadd --gid 10001 hubqa && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/hubqa hubqa
WORKDIR /opt/hub/source/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
COPY testframework/docker/entrypoints/backend-unit.sh /usr/local/bin/backend-unit
RUN chmod 0555 /usr/local/bin/backend-unit
ENV GOCACHE=/reports/backend-unit/go-cache
ENV HOME=/tmp
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/backend-unit"]

FROM mcr.microsoft.com/playwright@sha256:57b65fdc9ceabe0ef613124c7bbe2babcf9362c4d85e382fe3b03604e84b428a AS frontend-unit
RUN groupadd --gid 10001 hubqa && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/hubqa hubqa
WORKDIR /opt/hub/source/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/src/ ./src/
COPY frontend/tests/ ./tests/
COPY frontend/public/ ./public/
COPY frontend/index.html frontend/biome.json frontend/components.json frontend/tsconfig.json frontend/vite.config.ts ./
COPY testframework/docker/vitest.frontend-unit.config.ts /opt/hub/testframework/docker/vitest.frontend-unit.config.ts
COPY testframework/docker/entrypoints/frontend-unit.sh /usr/local/bin/frontend-unit
RUN chmod 0555 /usr/local/bin/frontend-unit
ENV HOME=/reports/frontend-unit/home
ENV TMPDIR=/reports/frontend-unit/tmp
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/frontend-unit"]

FROM python@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36 AS python-base
RUN groupadd --gid 10001 hubqa && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/hubqa hubqa
RUN python -m pip install --no-cache-dir uv==0.12.0
RUN mkdir -p /opt/hub/testframework /opt/hub/.venv && chown -R 10001:10001 /opt/hub/testframework /opt/hub/.venv

FROM python-base AS python-tests
WORKDIR /opt/hub/testframework
COPY testframework/pyproject.toml testframework/uv.lock ./
RUN UV_PROJECT_ENVIRONMENT=/opt/hub/.venv uv sync --frozen --all-groups --no-install-project
COPY testframework/src/ ./src/
COPY testframework/selftests/ ./selftests/
COPY testframework/tests/ ./tests/
COPY testframework/cases/ ./cases/
COPY testframework/policies/ ./policies/
COPY testframework/schemas/ ./schemas/
COPY testframework/load/ ./load/
COPY testframework/docker/entrypoints/python-qa.sh /usr/local/bin/python-qa
RUN chmod 0555 /usr/local/bin/python-qa && chown -R 10001:10001 /opt/hub/testframework /opt/hub/.venv
ENV PATH=/opt/hub/.venv/bin:$PATH
ENV PYTHONPATH=/opt/hub/testframework/src
ENV PYTHONSAFEPATH=1
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/python-qa"]

FROM python-base AS python-lock
WORKDIR /opt/hub/testframework
COPY --chown=10001:10001 testframework/pyproject.toml ./pyproject.toml
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/uv", "lock"]
