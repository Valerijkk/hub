FROM golang@sha256:bbb255b0e131db500cf0520adc97441d2260cf629c7fa7e39e025ddf53995a24 AS backend-unit
RUN groupadd --gid 10001 hubqa && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/hubqa hubqa
WORKDIR /opt/hub/source/backend
COPY backend/go.mod backend/go.sum ./
RUN go mod download
COPY backend/ ./
RUN go generate ./ent
RUN test -f ent/ent.go -a -f ent/client.go -a -f ent/migrate/schema.go
COPY testframework/docker/entrypoints/backend-unit.sh /usr/local/bin/backend-unit
RUN sed -i 's/\r$//' /usr/local/bin/backend-unit && chmod 0555 /usr/local/bin/backend-unit
COPY testframework/docker/backend_unit/ /usr/local/lib/hub/backend-unit/
RUN find /usr/local/lib/hub/backend-unit -type f -exec sed -i 's/\r$//' {} + && chmod 0555 /usr/local/lib/hub/backend-unit/runtime.sh /usr/local/lib/hub/backend-unit/plan.sh /usr/local/lib/hub/backend-unit/execute.sh /usr/local/lib/hub/backend-unit/receipt.sh
ENV GOCACHE=/var/cache/hub-go
ENV GOTMPDIR=/var/tmp/hub-go
ENV HOME=/tmp
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/backend-unit"]

FROM mcr.microsoft.com/playwright@sha256:57b65fdc9ceabe0ef613124c7bbe2babcf9362c4d85e382fe3b03604e84b428a AS frontend-unit
RUN groupadd --gid 10001 hubqa && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/hubqa hubqa
WORKDIR /opt/hub/source/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/src/ ./src/
COPY frontend/tests/ ./tests/
RUN find /opt/hub/source/frontend/src /opt/hub/source/frontend/tests -type f -exec sed -i 's/\r$//' {} +
COPY frontend/public/ ./public/
COPY frontend/index.html frontend/biome.json frontend/components.json frontend/tsconfig.json frontend/vite.config.ts ./
COPY testframework/docker/vitest.frontend-unit.config.ts /opt/hub/source/frontend/.qa/vitest.frontend-unit.config.ts
COPY testframework/docker/entrypoints/frontend-unit.sh /usr/local/bin/frontend-unit
RUN sed -i 's/\r$//' /usr/local/bin/frontend-unit && chmod 0555 /usr/local/bin/frontend-unit
ENV HOME=/reports/frontend-unit/home
ENV TMPDIR=/reports/frontend-unit/tmp
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/frontend-unit"]

FROM python@sha256:229a2c5bfa27522db7815ea81f9bed70af17ccb9de9fc7ad142b1877b5830d36 AS python-base
RUN groupadd --gid 10001 hubqa && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/hubqa hubqa
RUN python -m pip install --no-cache-dir uv==0.12.0
RUN mkdir -p /opt/hub/testframework /opt/hub/.venv && chown -R 10001:10001 /opt/hub/testframework /opt/hub/.venv

FROM python-base AS python-tests
WORKDIR /opt/hub/testframework
COPY testframework/pyproject.toml testframework/uv.lock testframework/.python-version testframework/README.md ./
RUN UV_PROJECT_ENVIRONMENT=/opt/hub/.venv uv sync --frozen --all-groups --no-install-project
COPY testframework/src/ ./src/
RUN UV_PROJECT_ENVIRONMENT=/opt/hub/.venv uv sync --frozen --all-groups
COPY testframework/observers/ ./observers/
COPY docker-compose.local.yml /opt/hub/docker-compose.local.yml
COPY .planning/phases/130-tf-traceability-gates/PLAN.md /opt/hub/.planning/phases/130-tf-traceability-gates/PLAN.md
COPY testframework/docker/ ./docker/
RUN find /opt/hub/docker-compose.local.yml /opt/hub/.planning/phases/130-tf-traceability-gates/PLAN.md /opt/hub/testframework/docker -type f -exec sed -i 's/\r$//' {} +
COPY testframework/selftests/ ./selftests/
COPY testframework/tests/ ./tests/
COPY testframework/cases/ ./cases/
COPY testframework/policies/ ./policies/
COPY testframework/schemas/ ./schemas/
COPY testframework/load/ ./load/
RUN find /opt/hub/testframework/cases /opt/hub/testframework/policies /opt/hub/testframework/schemas -type f -exec sed -i 's/\r$//' {} +
COPY testframework/docker/entrypoints/python-qa.sh /usr/local/bin/python-qa
RUN sed -i 's/\r$//' /usr/local/bin/python-qa && chmod 0555 /usr/local/bin/python-qa && chown -R 10001:10001 /opt/hub/testframework /opt/hub/.venv
ENV PATH=/opt/hub/.venv/bin:$PATH
ENV PYTHONPATH=/opt/hub/testframework/src:/opt/hub/testframework
ENV PYTHONSAFEPATH=1
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/python-qa"]

FROM python-base AS python-lock
RUN mkdir -p /workspace/testframework /opt/hub/uv-cache /opt/hub/lock-input /home/hubqa && chown -R 10001:10001 /workspace/testframework /opt/hub/uv-cache /opt/hub/lock-input /home/hubqa
WORKDIR /workspace/testframework
COPY --chown=10001:10001 testframework/pyproject.toml /opt/hub/lock-input/pyproject.toml
ENV HOME=/home/hubqa
ENV UV_CACHE_DIR=/opt/hub/uv-cache
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/uv", "lock"]
