{
  "schema": "hub.qa.local-source-policy/v1",
  "status": "NOT_READY",
  "source_commit": "ae1b5e58239ddf82b2c9a8133b244957ddd76237",
  "materialization": {
    "authority": "exact-commit-tree-only",
    "forbid_worktree_copy": true,
    "forbid_symlinks": true,
    "max_files": 20000,
    "max_file_bytes": 33554432,
    "max_total_bytes": 536870912,
    "manifest": {
      "algorithm": "sha256",
      "encoding": "utf-8",
      "record": "path<TAB>mode-octal<TAB>sha256-lowercase<LF>",
      "field_separator": "U+0009",
      "record_separator": "U+000A",
      "sort": "lexicographic-utf8-unsigned-byte-by-path-shorter-prefix-first"
    },
    "exclude_segments_any_depth": [
      ".git",
      ".planning",
      "pro-qa-ai",
      "QAEF",
      "reports",
      "generated",
      "legacy"
    ]
  },
  "include": [
    "backend/**",
    "frontend/src/**",
    "frontend/tests/**",
    "frontend/public/**",
    "frontend/index.html",
    "frontend/biome.json",
    "frontend/package.json",
    "frontend/package-lock.json",
    "frontend/vite.config.ts",
    "frontend/tsconfig.json"
  ],
  "exclude": [
    ".git/**",
    ".planning/**",
    "pro-qa-ai/**",
    "QAEF/**",
    "**/QAEF/**",
    "testframework/reports/**",
    "testframework/stages/**",
    "backend/testframework/**",
    "backend/bin/**",
    "backend/reports/**",
    "backend/**/.git/**",
    "backend/**/.planning/**",
    "backend/**/pro-qa-ai/**",
    "backend/**/QAEF/**",
    "backend/**/reports/**",
    "backend/**/generated/**",
    "backend/**/legacy/**",
    "frontend/node_modules/**",
    "frontend/dist/**",
    "frontend/**/.git/**",
    "frontend/**/.planning/**",
    "frontend/**/pro-qa-ai/**",
    "frontend/**/QAEF/**",
    "frontend/**/reports/**",
    "frontend/**/generated/**",
    "frontend/**/legacy/**",
    "**/generated/**",
    "**/legacy/**"
  ],
  "compose": {
    "source_or_repository_bind": "forbidden",
    "only_persistent_bind": "task-owned-report-directory"
  }
}
