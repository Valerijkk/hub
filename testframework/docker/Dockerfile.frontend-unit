FROM sha256:753f831a898523662c36011748ba0729b59838745d577c61c91287fe1778bfe1

ARG A1_BINDING_STATUS
ARG DEPENDENCY_BUNDLE_SHA256
ARG SOURCE_POLICY_V2_SHA256
ARG BUILD_MANIFEST_V3_SHA256

LABEL hub.qa.target="frontend-unit" \
      hub.qa.execution-authority="hub.qa-bootstrap/v1" \
      hub.qa.network="none" \
      hub.qa.runtime-status="NOT_RUN"

WORKDIR /opt/hub/source/frontend

# The A1-controlled context is the only allowed source for dependency bytes or
# binding data.  It is deliberately absent until approved offline ingress.
COPY bindings/dependency-bundle.manifest.v1.json /opt/hub/bindings/dependency-bundle.manifest.v1.json
COPY bindings/source-policy.v2.json /opt/hub/bindings/source-policy.v2.json
COPY bindings/build-manifest.v3.json /opt/hub/bindings/build-manifest.v3.json
COPY bindings/assets/frontend-node-modules/ /opt/hub/frontend/node_modules/
COPY config/vitest.frontend-unit.config.ts /opt/hub/config/vitest.frontend-unit.config.ts
COPY source/frontend/ /opt/hub/source/frontend/
COPY entrypoints/frontend-unit.sh /opt/hub/bin/frontend-unit

RUN test "$A1_BINDING_STATUS" = "BOUND" \
 && test -n "$DEPENDENCY_BUNDLE_SHA256" \
 && test -n "$SOURCE_POLICY_V2_SHA256" \
 && test -n "$BUILD_MANIFEST_V3_SHA256" \
 && chmod 0555 /opt/hub/bin/frontend-unit

ENTRYPOINT ["/opt/hub/bin/frontend-unit"]
CMD ["--hub-qa-target=frontend-unit"]
