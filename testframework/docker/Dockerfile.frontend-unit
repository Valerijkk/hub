FROM sha256:753f831a898523662c36011748ba0729b59838745d577c61c91287fe1778bfe1

ARG SOURCE_COMMIT
ARG BASE_IMAGE_ID
ARG SOURCE_POLICY_SHA256
ARG SOURCE_TREE_MANIFEST_SHA256
ARG BUILD_MANIFEST_SHA256
ARG CONTROL_COMMIT
ARG CONTROL_BUNDLE_SHA256

LABEL hub.qa.target="frontend-unit" \
      hub.qa.base-image-id="${BASE_IMAGE_ID}" \
      hub.qa.control-commit="${CONTROL_COMMIT}" \
      hub.qa.control-bundle-sha256="${CONTROL_BUNDLE_SHA256}" \
      hub.qa.source-commit="${SOURCE_COMMIT}" \
      hub.qa.source-policy-sha256="${SOURCE_POLICY_SHA256}" \
      hub.qa.source-tree-manifest-sha256="${SOURCE_TREE_MANIFEST_SHA256}" \
      hub.qa.build-manifest-sha256="${BUILD_MANIFEST_SHA256}" \
      hub.qa.runtime-status="NOT_READY"

WORKDIR /opt/hub/source/frontend
COPY source/frontend/ /opt/hub/source/frontend/
RUN set -eu; mkdir -p /opt/hub/bin; printf '%s\n' '#!/bin/sh' 'set -eu' 'printf "%s\\n" "{\\"target\\":\\"frontend-unit\\",\\"status\\":\\"NOT_READY\\",\\"reason\\":\\"approved package-lock-matched node_modules and dedicated Vitest config are absent\\"}"' 'exit 66' > /opt/hub/bin/frontend-unit; chmod 0555 /opt/hub/bin/frontend-unit

ENTRYPOINT ["/opt/hub/bin/frontend-unit"]
