FROM sha256:1dd0b0cab49abf58ae61bd6509b455375952dc17b7d8a5796905221b78e3531c

LABEL hub.qa.target="backend-unit" \
      hub.qa.execution-authority="hub.qa-bootstrap/v1" \
      hub.qa.network="none" \
      hub.qa.runtime-status="NOT_RUN"

WORKDIR /opt/hub/source/backend

COPY bindings/dependency-bundle.manifest.v1.json /opt/hub/bindings/dependency-bundle.manifest.v1.json
COPY bindings/source-policy.v2.json /opt/hub/bindings/source-policy.v2.json
COPY bindings/build-manifest.v3.json /opt/hub/bindings/build-manifest.v3.json
ADD bindings/assets/go-module-cache.tar /opt/hub/offline/go-module-cache/
ADD bindings/assets/go-race-toolchain.tar /opt/hub/offline/go-race-toolchain/
COPY source/backend/ /opt/hub/source/backend/
COPY --chmod=0555 entrypoints/backend-unit.sh /opt/hub/bin/backend-unit

ENV A1_BINDING_STATUS=BOUND \
    GOPROXY=off \
    GOSUMDB=off \
    GOMODCACHE=/opt/hub/offline/go-module-cache/pkg/mod
ENV CGO_ENABLED=1 CC=/opt/hub/offline/go-race-toolchain/bin/cc

ENTRYPOINT ["/opt/hub/bin/backend-unit"]
CMD ["--hub-qa-target=backend-unit"]
