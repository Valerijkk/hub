FROM sha256:54a0b2beae90fe14c2131f1e880e1388c9df77390bc260d7317e589765e064e8

ARG SOURCE_COMMIT
ARG BASE_IMAGE_ID
ARG SOURCE_POLICY_SHA256
ARG SOURCE_TREE_MANIFEST_SHA256
ARG BUILD_MANIFEST_SHA256
ARG CONTROL_COMMIT
ARG CONTROL_BUNDLE_SHA256

LABEL hub.qa.target="backend-openapi" \
      hub.qa.base-image-id="${BASE_IMAGE_ID}" \
      hub.qa.control-commit="${CONTROL_COMMIT}" \
      hub.qa.control-bundle-sha256="${CONTROL_BUNDLE_SHA256}" \
      hub.qa.source-commit="${SOURCE_COMMIT}" \
      hub.qa.source-policy-sha256="${SOURCE_POLICY_SHA256}" \
      hub.qa.source-tree-manifest-sha256="${SOURCE_TREE_MANIFEST_SHA256}" \
      hub.qa.build-manifest-sha256="${BUILD_MANIFEST_SHA256}" \
      hub.qa.runtime-status="NOT_READY"

WORKDIR /opt/hub/source/backend
COPY source/backend/ /opt/hub/source/backend/
RUN set -eu; mkdir -p /opt/hub/bin; printf '%s\n' '#!/bin/sh' 'set -eu' 'printf "%s\\n" "{\\"target\\":\\"backend-openapi\\",\\"status\\":\\"NOT_READY\\",\\"reason\\":\\"approved pinned swag binary and Go module-cache provenance are absent\\"}"' 'exit 66' > /opt/hub/bin/backend-openapi; chmod 0555 /opt/hub/bin/backend-openapi

ENTRYPOINT ["/opt/hub/bin/backend-openapi"]
