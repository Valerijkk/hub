{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hub.qa.repository-snapshot/v1",
  "title": "Hub QA repository snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "producer", "snapshot_id", "captured_for", "task", "run", "envelope_id", "role_claim", "self_attested", "source_revision", "head", "index", "worktree", "commits", "ancestry", "control", "evidence", "lifecycle"],
  "properties": {
    "schema": {"const": "hub.qa.repository-snapshot/v1"},
    "producer": {"const": "hub.qa.repository-snapshot-producer/v1"},
    "snapshot_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}-snapshot-[a-z0-9][a-z0-9-]{7,63}-[0-9]{3}-[A-Z_]+$"},
    "captured_for": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "ordinal", "subject_path", "subject_sha256", "subject_commit_sha", "predecessor_event_path", "predecessor_event_sha256", "predecessor_event_commit_sha", "pre_event_snapshot_path", "pre_event_snapshot_sha256"],
      "properties": {
        "kind": {"enum": ["G0_BOOTSTRAP", "GENESIS_BASELINE", "OWNER_MUTATION_AFTER", "OWNER_RECEIPT_AFTER", "INDEPENDENT_VERDICT_AFTER", "ROLLBACK_MUTATION_AFTER", "ROLLBACK_RECEIPT_AFTER", "ROLLBACK_VERDICT_AFTER"]},
        "ordinal": {"type": "integer", "minimum": 0},
        "subject_path": {"anyOf": [{"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00-\\x1f\\\\]+$"}, {"type": "null"}]},
        "subject_sha256": {"anyOf": [{"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, {"type": "null"}]},
        "subject_commit_sha": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{40}$"}, {"type": "null"}]},
        "predecessor_event_path": {"anyOf": [{"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00-\\x1f\\\\]+$"}, {"type": "null"}]},
        "predecessor_event_sha256": {"anyOf": [{"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, {"type": "null"}]},
        "predecessor_event_commit_sha": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{40}$"}, {"type": "null"}]},
        "pre_event_snapshot_path": {"anyOf": [{"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00-\\x1f\\\\]+$"}, {"type": "null"}]},
        "pre_event_snapshot_sha256": {"anyOf": [{"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, {"type": "null"}]}
      }
    },
    "task": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"},
    "run": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "envelope_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}-envelope-[a-z0-9][a-z0-9-]{7,63}$"},
    "role_claim": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[\\x21-\\x7e]+$"},
    "self_attested": {"type": "boolean"},
    "source_revision": {
      "type": "object", "additionalProperties": false, "required": ["commit", "tree", "captured_at_utc"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "captured_at_utc": {"type": "string", "minLength": 20, "maxLength": 28, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"}
      }
    },
    "head": {
      "type": "object", "additionalProperties": false, "required": ["commit", "tree", "event"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "event": {
          "type": "object", "additionalProperties": false, "required": ["event_id", "event_type", "captured_at_utc"],
          "properties": {
            "event_id": {"type": ["string", "null"]},
            "event_type": {"type": ["string", "null"]},
            "captured_at_utc": {"anyOf": [{"type": "string", "minLength": 20, "maxLength": 28, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"}, {"type": "null"}]}
          }
        }
      }
    },
    "index": {
      "type": "object", "additionalProperties": false, "required": ["paths", "count", "sha256"],
      "properties": {
        "paths": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "status", "blob_sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00-\\x1f\\\\]+$"}, "status": {"type": "string", "pattern": "^[A-Z?][A-Z0-9?]{0,7}$"}, "blob_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}},
        "count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "worktree": {
      "type": "object", "additionalProperties": false, "required": ["scoped_paths", "count", "sha256"],
      "properties": {
        "scoped_paths": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "state", "blob_sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00-\\x1f\\\\]+$"}, "state": {"type": "string", "pattern": "^[A-Z?][A-Z0-9?]{0,7}$"}, "blob_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}},
        "count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "commits": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["commit", "parent", "tree", "changed_paths"], "properties": {
        "commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "parent": {"anyOf": [{"type": "string", "pattern": "^[a-f0-9]{40}$"}, {"type": "null"}]},
        "tree": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "changed_paths": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "status", "blob_sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00-\\x1f\\\\]+$"}, "status": {"type": "string", "pattern": "^[A-Z?][A-Z0-9?]{0,7}$"}, "blob_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}}}}
      }}
    },
    "ancestry": {
      "type": "object", "additionalProperties": false, "required": ["edges"],
      "properties": {"edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["child", "parent"], "properties": {"child": {"type": "string", "pattern": "^[a-f0-9]{40}$"}, "parent": {"type": "string", "pattern": "^[a-f0-9]{40}$"}}}}}
    },
    "control": {
      "type": "object", "additionalProperties": false,
      "required": ["g0_plan_sha256", "bootstrap_contract_sha256", "runner_contract_sha256", "dependency_bundle_manifest_sha256", "source_policy_sha256", "build_manifest_sha256", "images_lock_sha256"],
      "properties": {
        "g0_plan_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "bootstrap_contract_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "runner_contract_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "dependency_bundle_manifest_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "source_policy_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "build_manifest_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "images_lock_sha256": {"anyOf": [{"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, {"type": "null"}]}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["positive_green_path", "positive_green_sha256", "candidate_lock_path", "candidate_lock_sha256", "cleanup_path", "cleanup_sha256"],
      "properties": {
        "positive_green_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00-\\x1f\\\\]+$"},
        "positive_green_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "candidate_lock_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00-\\x1f\\\\]+$"},
        "candidate_lock_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "cleanup_path": {"type": "string", "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\x00-\\x1f\\\\]+$"},
        "cleanup_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "lifecycle": {
      "type": "object", "additionalProperties": false, "required": ["state", "started_at_utc", "finished_at_utc"],
      "properties": {
        "state": {"enum": ["CAPTURED", "FAILED"]},
        "started_at_utc": {"anyOf": [{"type": "string", "minLength": 20, "maxLength": 28, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"}, {"type": "null"}]},
        "finished_at_utc": {"anyOf": [{"type": "string", "minLength": 20, "maxLength": 28, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"}, {"type": "null"}]}
      }
    }
  }
}
