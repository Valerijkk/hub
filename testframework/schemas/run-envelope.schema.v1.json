{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hub.qa.run-envelope/v1",
  "title": "Hub QA run envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "producer", "envelope_id", "contract", "target", "task", "run", "owner_nonce", "repository_snapshot_sha256", "report_root", "limits", "cleanup_contract", "created_at_utc"],
  "properties": {
    "schema": {"const": "hub.qa.run-envelope/v1"},
    "producer": {"const": "hub.qa.run-envelope-producer/v1"},
    "envelope_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}-envelope-[a-z0-9][a-z0-9-]{7,63}$"},
    "contract": {"const": "hub.qa-runner/v2"},
    "target": {"enum": ["backend-unit", "frontend-unit", "backend-openapi", "g0-planning-selftest", "recovery-successor-authority"]},
    "task": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"},
    "run": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "owner_nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "repository_snapshot_sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "report_root": {"type": "string", "pattern": "^testframework/reports/[a-z][a-z0-9-]{2,31}-[a-z0-9][a-z0-9-]{7,63}$"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
        "required": ["command_seconds", "target_seconds", "inspect_seconds", "outer_seconds", "cleanup_seconds", "orchestration_slack_seconds"],
      "properties": {
        "command_seconds": {"const": 180},
        "target_seconds": {"const": 780},
        "inspect_seconds": {"const": 30},
        "outer_seconds": {"const": 840},
        "cleanup_seconds": {"const": 30},
        "orchestration_slack_seconds": {"const": 30}
      }
    },
    "cleanup_contract": {"const": "hub.qa.exact-cleanup/v1"},
    "created_at_utc": {"type": "string", "minLength": 20, "maxLength": 28, "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,7})?Z$"}
  }
}
