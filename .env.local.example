# Local development secrets (INF-03).
# Copy to .env.local and fill in. NEVER commit .env.local.
#
# docker-compose.local.yml reads these via ${VAR:-} substitution.
# If Resend/Telegram tokens were ever committed to git, rotate them:
#   - Resend: https://resend.com/api-keys
#   - Telegram: @BotFather → /revoke

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
TELEGRAM_BOT_TOKEN=

# Observability (Phase 32 — optional OTLP traces)
# When set, hub-backend exports HTTP + Timed() spans to Grafana Tempo / Jaeger.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hub-backend

HUB_MAIL_PORT=3001
HUB_MAIL_INTERNAL_TOKEN=
HUB_MAIL_URL=http://127.0.0.1:3001
RESEND_FROM_ALERTS=alerts@hub.local
