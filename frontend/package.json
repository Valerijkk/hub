{
  "name": "hub-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "node scripts/link-e2e-node-modules.mjs && playwright test -c playwright.config.ts",
    "test:e2e:a11y": "node scripts/link-e2e-node-modules.mjs && playwright test -c playwright.config.ts --grep a11y",
    "lighthouse:help": "echo Run: npm run build && npm run preview then npx lighthouse http://localhost:4173/login --only-categories=accessibility,performance,best-practices --chrome-flags=--headless",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "lint": "biome check ./src",
    "lighthouse:ci": "node scripts/lighthouse-ci.mjs"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.7.9",
    "@hookform/resolvers": "^5.4.0",
    "@livekit/components-react": "^2.9.20",
    "@livekit/components-styles": "^1.2.0",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-router": "^1.0.0",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/react-grid-layout": "^1.3.6",
    "@udecode/plate": "^48.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "latest",
    "cmdk": "^1.1.1",
    "i18next": "^25.9.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "livekit-client": "^2.17.3",
    "lucide-react": "^0.577.0",
    "motion": "^12.40.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-grid-layout": "^2.2.2",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^16.5.8",
    "recharts": "^3.8.0",
    "sonner": "latest",
    "tailwind-merge": "latest",
    "zod": "^4.4.3",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "latest",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tanstack/router-plugin": "latest",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "happy-dom": "^20.10.5",
    "jsdom": "^27.0.1",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
