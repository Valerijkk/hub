# Hub Frontend — переменные окружения (Vite)
# Скопируйте в .env.local и заполните реальными значениями.
# ВАЖНО: все VITE_-переменные попадают в клиентский бандл — не храните здесь
# приватные секреты (только публичные / клиентские ключи).

# Ключ GIPHY API для GIF-пикера в мессенджере (https://developers.giphy.com).
# Без ключа GIF-пикер покажет ошибку загрузки — остальной мессенджер работает.
VITE_GIPHY_API_KEY=

# URL LiveKit-сервера для звонков (по умолчанию ws://<host>:7880).
# VITE_LIVEKIT_URL=
