# LiveKit production config — REFERENCE ONLY (SEC-03).
#
# Production does NOT mount this file. docker-compose.prod.yml generates
# /tmp/livekit.yaml at container start from LIVEKIT_API_KEY / LIVEKIT_API_SECRET
# env vars (see livekit service heredoc). Copy values into deployments/.env.
#
# Local dev uses deployments/livekit.yaml (committed dev-only keys).
#
# If you previously deployed with deployments/livekit-prod.yaml (devkey: secret),
# rotate LIVEKIT_API_KEY and LIVEKIT_API_SECRET before next deploy.

port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}
webhook:
  api_key: ${LIVEKIT_API_KEY}
  urls:
    - "http://backend:3000/api/calls/webhook"
logging:
  level: info
room:
  empty_timeout: 300
  departure_timeout: 120
  max_participants: 50
