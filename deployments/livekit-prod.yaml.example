# Конфигурация LiveKit для production — ТОЛЬКО СПРАВОЧНИК (SEC-03).
#
# В production этот файл НЕ монтируется. docker-compose.prod.yml генерирует
# /tmp/livekit.yaml при старте контейнера из переменных LIVEKIT_API_KEY /
# LIVEKIT_API_SECRET (см. heredoc сервиса livekit). Значения копируйте в deployments/.env.
#
# Локальная разработка использует deployments/livekit.yaml (dev-ключи в репозитории).
#
# Если ранее деплоили с deployments/livekit-prod.yaml (devkey: secret),
# выполните ротацию LIVEKIT_API_KEY и LIVEKIT_API_SECRET перед следующим деплоем.

port: 7880
rtc:
  tcp_port: 7881
  port_range_start: 50000
  port_range_end: 50100
  use_external_ip: true
keys:
  ${LIVEKIT_API_KEY}: ${LIVEKIT_API_SECRET}
webhook:
  api_key: ${LIVEKIT_API_KEY}
  urls:
    - "http://backend:3000/api/calls/webhook"
logging:
  level: info
room:
  empty_timeout: 300
  departure_timeout: 120
  max_participants: 50
