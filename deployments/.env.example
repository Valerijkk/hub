# ===========================================
# Hub Platform — переменные production-окружения
# ===========================================
# Скопируйте в .env и заполните реальными значениями.
# НИКОГДА не коммитьте .env в систему контроля версий.

# --- PostgreSQL ---
POSTGRES_USER=hub
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=hub

# --- MongoDB ---
MONGO_USER=hub
MONGO_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MONGO_DB=hub

# --- Redis ---
REDIS_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- S3 / SeaweedFS ---
# Prod: НЕ используйте hub/hubsecret — config.validate отвергает их при DEV_MODE=false.
# SeaweedFS identity генерируется из этих env при старте (A14-002).
S3_ACCESS_KEY=CHANGE_ME_NON_DEFAULT_KEY
S3_SECRET_KEY=CHANGE_ME_STRONG_PASSWORD
S3_BUCKET=hub
S3_REGION=us-east-1

# --- JWT ---
JWT_SECRET=CHANGE_ME_MINIMUM_32_CHARS_RANDOM_STRING

# --- Токены интеграций (AES-GCM для GitHub/GitLab) ---
INTEGRATION_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_BASE64_OR_HEX_KEY

# --- CORS (origins через запятую; обязательно при DEV_MODE=false) ---
CORS_ORIGINS=https://yourdomain.com

# --- Resend (транзакционная почта) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@yourdomain.com

# --- hub-mail (микросервис alert/транзакционной почты, Phase 15.2) ---
# Внутренний shared-secret между backend и hub-mail (X-Hub-Internal-Token).
HUB_MAIL_INTERNAL_TOKEN=CHANGE_ME_RANDOM_SHARED_SECRET
# From-адрес для alert-писем (по умолчанию alerts@hub.local).
RESEND_FROM_ALERTS=alerts@yourdomain.com
# Суточный лимит alert-писем (по умолчанию 20).
MAIL_DAILY_LIMIT=20

# --- Telegram (только уведомления, не login) ---
TELEGRAM_BOT_TOKEN=123456789:ABCDefGHIjklMNOpqrsTUVwxyz

# --- LiveKit (голосовые/видео звонки) ---
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret-min-32-chars

# --- Docker-образы (опционально; по умолчанию ghcr.io) ---
# IMAGE_BACKEND=ghcr.io/valerijkk/hub/backend:latest
# IMAGE_FRONTEND=ghcr.io/valerijkk/hub/frontend:latest

# --- Observability (фаза 33) ---
# CIDR, которым разрешён scrape GET /metrics (пусто = все).
# Пример для Docker overlay мониторинга: 172.16.0.0/12,10.0.0.0/8
# METRICS_ALLOWED_CIDRS=
# ALERT_WEBHOOK_SECRET=CHANGE_ME_RANDOM_SECRET_FOR_ALERTMANAGER_BEARER
# OTEL_EXPORTER_OTLP_ENDPOINT=http://tempo:4318
# OTEL_SERVICE_NAME=hub-backend
# GRAFANA_ADMIN_PASSWORD=changeme
# Alertmanager prod: скопируйте monitoring/alertmanager/alertmanager.prod.example.yml → alertmanager.yml

# --- Deploy SSH (секреты GitHub Actions, здесь не используются) ---
# SSH_HOST=your-server.com
# SSH_USER=deploy
# SSH_KEY=<содержимое приватного ключа>
