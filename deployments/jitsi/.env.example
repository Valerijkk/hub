# Hub Phase 150 — PARTIAL / STATIC_FOUNDATION_ONLY
# LiveKit remains the active provider. Jitsi is unavailable until Phase 152.
# This file declares only the future self-hosted deployment boundary; it does
# not create, bind, pull, render, or start a Jitsi overlay.

CALLS_ACTIVE_PROVIDER=livekit
JITSI_ENABLED=false

# Canonical public identity. JITSI_PUBLIC_URL must be exactly https:// + JITSI_HOST.
JITSI_HOST=meet.hub.example.com
JITSI_PUBLIC_URL=https://meet.hub.example.com

# Single XMPP root source. The future overlay maps XMPP_DOMAIN from this value.
JITSI_XMPP_DOMAIN=meet.hub.example.com
XMPP_AUTH_DOMAIN=auth.meet.hub.example.com
XMPP_MUC_DOMAIN=muc.meet.hub.example.com
XMPP_INTERNAL_MUC_DOMAIN=internal-muc.meet.hub.example.com
# Guest domain intentionally not enabled.

JITSI_APP_ID=hub
# Hub secret-store name. The future overlay maps this value only to upstream JWT_APP_SECRET.
JITSI_APP_SECRET=__REQUIRED_UNUSABLE_NO_DEFAULT__
JICOFO_COMPONENT_SECRET=__REQUIRED_UNUSABLE_NO_DEFAULT__
JICOFO_AUTH_PASSWORD=__REQUIRED_UNUSABLE_NO_DEFAULT__
JVB_AUTH_PASSWORD=__REQUIRED_UNUSABLE_NO_DEFAULT__
JITSI_EVENT_HMAC_SECRET=__REQUIRED_UNUSABLE_NO_DEFAULT__

# No public STUN fallback. The selected-image overlay must prove this mapping.
JVB_DISABLE_STUN=true
# Use the JVB for one-to-one calls; do not negotiate browser P2P.
ENABLE_P2P=false
# Keep JaaS-specific components disabled in the future self-hosted overlay.
ENABLE_JAAS_COMPONENTS=false
JVB_ADVERTISE_IPS=__REQUIRED_UNUSABLE_NO_DEFAULT__
