FROM --platform=linux/amd64 docker.io/arigaio/atlas@sha256:ca911e2db73ab32a9b85953a70484ab70cda9f9fadc8b5c7c594910c5dc87478 AS atlas-cli

FROM golang@sha256:bbb255b0e131db500cf0520adc97441d2260cf629c7fa7e39e025ddf53995a24 AS module-cache

WORKDIR /src
COPY go.mod go.sum ./
COPY docker/schema-tool.lock.json ./schema-tool.lock.json
ENV GOTOOLCHAIN=local \
    GOWORK=off
RUN set -eu; \
    normalized_file_has_exact_line() { \
      tr -d '\r' < "$2" | grep -Fqx -- "$1"; \
    }; \
    download_modules() { \
      attempt=1; \
      while [ "$attempt" -le 3 ]; do \
        if go mod download && go list -mod=readonly -deps entgo.io/ent/cmd/ent >/dev/null; then \
          return 0; \
        fi; \
        if [ "$attempt" -eq 3 ]; then \
          printf '%s\n' 'go module cache materialization failed after 3 attempts' >&2; \
          return 1; \
        fi; \
        attempt=$((attempt + 1)); \
        printf 'go module cache materialization failed; retrying (attempt %s of 3)\n' "$attempt" >&2; \
      done; \
      return 1; \
    }; \
    verify_source_module_lock() { \
      grep -Fqx '    "module": "ariga.io/atlas",' schema-tool.lock.json; \
      grep -Fqx '    "version": "v0.19.1-0.20240203083654-5948b60a8e43",' schema-tool.lock.json; \
      grep -Fqx '    "module_sum": "h1:GwdJbXydHCYPedeeLt4x/lrlIISQ4JTH1mRWuE5ZZ14=",' schema-tool.lock.json; \
      grep -Fqx '    "module_go_mod_sum": "h1:uj3pm+hUTVN/X5yfdBexHlZv+1Xu5u5ZbZx7+CDavNU=",' schema-tool.lock.json; \
      grep -Fqx '    "module": "entgo.io/ent",' schema-tool.lock.json; \
      grep -Fqx '    "version": "v0.14.1",' schema-tool.lock.json; \
      grep -Fqx '    "module_sum": "h1:fUERL506Pqr92EPHJqr8EYxbPioflJo6PudkrEA8a/s=",' schema-tool.lock.json; \
      grep -Fqx '    "module_go_mod_sum": "h1:MH6XLG0KXpkcDQhKiHfANZSzR55TJyPL5IGNpI8wpco=",' schema-tool.lock.json; \
      grep -Fqx '  "source_module_lock": {' schema-tool.lock.json; \
      grep -Fqx '    "go_mod_normalized_sha256": "3f7ff699a420ecf0501693c47ee18108a02a8827a547578bb6b800f83bcc2be6",' schema-tool.lock.json; \
      grep -Fqx '    "go_mod_normalized_bytes": 9763,' schema-tool.lock.json; \
      grep -Fqx '    "go_sum_normalized_sha256": "9a03c4db3f998434e3e9058a67b7d2143fda8c5a7ccee6895e9093d6e77d2510",' schema-tool.lock.json; \
      grep -Fqx '    "go_sum_normalized_bytes": 55553' schema-tool.lock.json; \
      test "$(tr -d '\r' < go.mod | sha256sum | cut -d ' ' -f1)" = '3f7ff699a420ecf0501693c47ee18108a02a8827a547578bb6b800f83bcc2be6'; \
      test "$(tr -d '\r' < go.mod | wc -c | tr -d '[:space:]')" = '9763'; \
      test "$(tr -d '\r' < go.sum | sha256sum | cut -d ' ' -f1)" = '9a03c4db3f998434e3e9058a67b7d2143fda8c5a7ccee6895e9093d6e77d2510'; \
      test "$(tr -d '\r' < go.sum | wc -c | tr -d '[:space:]')" = '55553'; \
    }; \
    if grep -Eq '^[[:space:]]*(replace|exclude)([[:space:]]|$)' go.mod; then \
      echo 'schema-maintenance: go.mod replace/exclude directives are forbidden' >&2; exit 1; \
    fi; \
    normalized_file_has_exact_line 'ariga.io/atlas v0.19.1-0.20240203083654-5948b60a8e43 h1:GwdJbXydHCYPedeeLt4x/lrlIISQ4JTH1mRWuE5ZZ14=' go.sum; \
    normalized_file_has_exact_line 'ariga.io/atlas v0.19.1-0.20240203083654-5948b60a8e43/go.mod h1:uj3pm+hUTVN/X5yfdBexHlZv+1Xu5u5ZbZx7+CDavNU=' go.sum; \
    normalized_file_has_exact_line 'entgo.io/ent v0.14.1 h1:fUERL506Pqr92EPHJqr8EYxbPioflJo6PudkrEA8a/s=' go.sum; \
    normalized_file_has_exact_line 'entgo.io/ent v0.14.1/go.mod h1:MH6XLG0KXpkcDQhKiHfANZSzR55TJyPL5IGNpI8wpco=' go.sum; \
    verify_source_module_lock; \
    download_modules; \
    verify_source_module_lock

COPY docker/schema-maintenance/materializer/main.go ./docker/schema-maintenance/materializer/main.go
RUN GOTOOLCHAIN=local \
    GOWORK=off \
    GOPROXY=off \
    GOSUMDB=off \
    GOMODCACHE=/go/pkg/mod \
    go list -mod=readonly -deps ./docker/schema-maintenance/materializer >/dev/null

FROM golang@sha256:bbb255b0e131db500cf0520adc97441d2260cf629c7fa7e39e025ddf53995a24 AS prefeature-source

WORKDIR /carrier
COPY docker/sources/mail-calendar-prefeature-f21/parent-source.tar ./parent-source.tar
RUN set -eu; \
    wc -c < parent-source.tar | tr -d ' ' | grep -qx '307200'; \
    printf '%s  %s\n' '988437e19435e30952e6afe03446115c0341a084b80d4a58f060ebfc1b3a8b90' 'parent-source.tar' | sha256sum -c -; \
    if LC_ALL=C tar -tvf parent-source.tar | cut -c1 | grep -qv '[-d]'; then exit 1; fi; \
    mkdir -p /opt/hub/prefeature; \
    tar --no-same-owner --no-same-permissions -xf parent-source.tar -C /opt/hub/prefeature; \
    if find /opt/hub/prefeature -mindepth 1 ! -type d ! -type f -print -quit | grep -q .; then exit 1; fi; \
    find /opt/hub/prefeature -mindepth 1 -type d | wc -l | tr -d ' ' | grep -qx '3'; \
    test -d /opt/hub/prefeature/backend; \
    test -d /opt/hub/prefeature/backend/ent; \
    test -d /opt/hub/prefeature/backend/ent/schema; \
    if find /opt/hub/prefeature -mindepth 1 -type d ! -path /opt/hub/prefeature/backend ! -path /opt/hub/prefeature/backend/ent ! -path /opt/hub/prefeature/backend/ent/schema -print -quit | grep -q .; then exit 1; fi; \
    find /opt/hub/prefeature -type f | wc -l | tr -d ' ' | grep -qx '89'; \
    if find /opt/hub/prefeature -type f ! -path /opt/hub/prefeature/backend/go.mod ! -path /opt/hub/prefeature/backend/go.sum ! -path '/opt/hub/prefeature/backend/ent/schema/*.go' -print -quit | grep -q .; then exit 1; fi; \
    test -f /opt/hub/prefeature/backend/go.mod; \
    test -f /opt/hub/prefeature/backend/go.sum; \
    find /opt/hub/prefeature -type f -printf '%P\n' | LC_ALL=C sort | sha256sum | cut -d ' ' -f1 | grep -qx 'e5d0a779c33506d1dd5e27c7e5ceb2947999bce8ebd1c8e40f9c45f830ff3eef'

FROM golang@sha256:bbb255b0e131db500cf0520adc97441d2260cf629c7fa7e39e025ddf53995a24 AS schema-maintenance

RUN groupadd --gid 10001 hubschema && useradd --uid 10001 --gid 10001 --create-home --home-dir /home/hubschema hubschema

WORKDIR /opt/hub/backend
COPY --from=atlas-cli /atlas /usr/local/bin/atlas
COPY --from=module-cache --chown=10001:10001 /go/pkg/mod/ /opt/hub/go/pkg/mod/
RUN chmod -R a-w /opt/hub/go/pkg/mod

COPY --chown=10001:10001 go.mod go.sum atlas.hcl ./
COPY --chown=10001:10001 ent/generate.go ./ent/generate.go
COPY --chown=10001:10001 ent/schema/ ./ent/schema/
COPY --chown=10001:10001 docker/schema-maintenance/materializer/main.go ./docker/schema-maintenance/materializer/main.go
COPY --chown=10001:10001 internal/mailvalue/dns.go ./internal/mailvalue/dns.go
COPY --chown=10001:10001 internal/mail/dns_types.go ./internal/mail/dns_types.go
COPY --chown=10001:10001 migrations/ ./migrations/
RUN mkdir -p /opt/hub/backend/migrations/atlas/mail-calendar-v1 && \
    chown 10001:10001 /opt/hub/backend/migrations/atlas/mail-calendar-v1
COPY --chown=10001:10001 docker/schema-tool.lock.json ./docker/schema-tool.lock.json
COPY --chown=10001:10001 docker/schema-materializer.lock.json ./docker/schema-materializer.lock.json
COPY --from=prefeature-source --chown=10001:10001 /opt/hub/prefeature/backend/ /opt/hub/prefeature/backend/
COPY docker/entrypoints/mail-calendar-schema.sh /usr/local/bin/mail-calendar-schema
RUN sed -i 's/\r$//' /usr/local/bin/mail-calendar-schema && \
    ! grep -q "$(printf '\r')" /usr/local/bin/mail-calendar-schema && \
    chmod 0555 /usr/local/bin/atlas /usr/local/bin/mail-calendar-schema && \
    test "$(stat -c '%U:%G:%a' /usr/local/bin/mail-calendar-schema)" = 'root:root:555' && \
    test "$(sed -n '1p' /usr/local/bin/mail-calendar-schema)" = '#!/bin/sh' && \
    test "$(/usr/local/bin/atlas version 2>&1 | sed -n '1p')" = 'atlas community version v1.3.2' && \
    test "$(sha256sum /usr/local/bin/atlas | awk '{print $1}')" = 'bdae7d2b6b903fdc4c40313fedfdf87f8a08ce1f2a4fd5c62fea2308419d526e' && \
    test "$(stat -c '%U:%G:%a' /usr/local/bin/atlas)" = 'root:root:555' && \
    tr -d '\r' < /opt/hub/backend/docker/schema-tool.lock.json | grep -Fqx -- '  "lock_version": 2,' && \
    tr -d '\r' < /opt/hub/backend/docker/schema-tool.lock.json | grep -Fqx -- '    "atlas_cli": {' && \
    tr -d '\r' < /opt/hub/backend/docker/schema-tool.lock.json | grep -Fqx -- '      "reference": "docker.io/arigaio/atlas@sha256:ca911e2db73ab32a9b85953a70484ab70cda9f9fadc8b5c7c594910c5dc87478",' && \
    tr -d '\r' < /opt/hub/backend/docker/schema-tool.lock.json | grep -Fqx -- '      "platform": "linux/amd64",' && \
    tr -d '\r' < /opt/hub/backend/docker/schema-tool.lock.json | grep -Fqx -- '      "expected_runtime_arch": "x86_64",' && \
    tr -d '\r' < /opt/hub/backend/docker/schema-tool.lock.json | grep -Fqx -- '      "source_binary": "/atlas",' && \
    tr -d '\r' < /opt/hub/backend/docker/schema-tool.lock.json | grep -Fqx -- '      "expected_version_output_first_line": "atlas community version v1.3.2",' && \
    tr -d '\r' < /opt/hub/backend/docker/schema-tool.lock.json | grep -Fqx -- '      "binary_sha256": "bdae7d2b6b903fdc4c40313fedfdf87f8a08ce1f2a4fd5c62fea2308419d526e"'

ENV GOTOOLCHAIN=local \
    GOWORK=off \
    GOPROXY=off \
    GOSUMDB=off \
    GOFLAGS=-mod=readonly \
    GOPATH=/opt/hub/go \
    GOMODCACHE=/opt/hub/go/pkg/mod

USER 10001:10001
ENTRYPOINT ["timeout", "--signal=TERM", "--kill-after=30s", "900", "/usr/local/bin/mail-calendar-schema"]
