{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pro-qa-ai:contracts:capability-profile:1.0",
  "title": "CapabilityProfile",
  "description": "Декларация scoped capabilities; enforcement выполняет controller, не эта запись.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "profile_id",
    "task_id",
    "authority_source",
    "policy_revision",
    "capabilities"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "CapabilityProfile"},
    "profile_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "authority_source": {
      "type": "string",
      "pattern": "^(human-approval|controller-policy):.+$"
    },
    "policy_revision": {
      "type": "string",
      "pattern": "^(UNKNOWN|[0-9a-fA-F]{40,64})$"
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "read",
        "write",
        "execute",
        "network_read",
        "network_write",
        "secrets",
        "install",
        "git_destructive",
        "external_write",
        "production"
      ],
      "properties": {
        "read": {"$ref": "#/$defs/decision"},
        "write": {"$ref": "#/$defs/decision"},
        "execute": {"$ref": "#/$defs/decision"},
        "network_read": {"$ref": "#/$defs/decision"},
        "network_write": {"$ref": "#/$defs/decision"},
        "secrets": {"$ref": "#/$defs/decision"},
        "install": {"$ref": "#/$defs/decision"},
        "git_destructive": {"$ref": "#/$defs/decision"},
        "external_write": {"$ref": "#/$defs/decision"},
        "production": {"$ref": "#/$defs/decision"}
      }
    }
  },
  "$defs": {
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "scopes", "approval_required", "reason"],
      "properties": {
        "allowed": {"type": "boolean"},
        "scopes": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "approval_required": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "expires_at": {"type": ["string", "null"]}
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "record_type": "CapabilityProfile",
      "profile_id": "CAP-TASK-001",
      "task_id": "TASK-001",
      "authority_source": "controller-policy:local-readonly",
      "policy_revision": "UNKNOWN",
      "capabilities": {
        "read": {"allowed": true, "scopes": ["standards/contracts/**"], "approval_required": false, "reason": "Нужно прочитать owned files."},
        "write": {"allowed": false, "scopes": [], "approval_required": true, "reason": "Запись не выдана."},
        "execute": {"allowed": false, "scopes": [], "approval_required": true, "reason": "Запуск не выдан."},
        "network_read": {"allowed": false, "scopes": [], "approval_required": true, "reason": "Сеть не выдана."},
        "network_write": {"allowed": false, "scopes": [], "approval_required": true, "reason": "Сетевая запись не выдана."},
        "secrets": {"allowed": false, "scopes": [], "approval_required": true, "reason": "Secrets не требуются."},
        "install": {"allowed": false, "scopes": [], "approval_required": true, "reason": "Install не разрешён."},
        "git_destructive": {"allowed": false, "scopes": [], "approval_required": true, "reason": "Destructive Git не разрешён."},
        "external_write": {"allowed": false, "scopes": [], "approval_required": true, "reason": "External write не разрешён."},
        "production": {"allowed": false, "scopes": [], "approval_required": true, "reason": "Production не разрешён."}
      }
    }
  ]
}
