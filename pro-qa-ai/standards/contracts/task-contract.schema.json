{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pro-qa-ai:contracts:task-contract:1.0",
  "title": "TaskContract",
  "description": "Декларативная запись задачи; не выдаёт полномочий и не заменяет controller policy.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "task_id",
    "objective",
    "acceptance_criteria",
    "constraints",
    "non_goals",
    "owned_paths",
    "risk",
    "required_evidence",
    "stop_conditions",
    "capability_profile_ref",
    "provenance_requirements",
    "requested_model",
    "budgets"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "TaskContract"},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "objective": {"type": "string", "minLength": 1, "maxLength": 2000},
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "constraints": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "non_goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "owned_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "capability_profile_ref": {"type": "string", "minLength": 1},
    "provenance_requirements": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requested_model": {"type": "string", "minLength": 1},
    "budgets": {"$ref": "#/$defs/budgets"}
  },
  "$defs": {
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_retries",
        "max_delegation_depth",
        "max_parallel_delegates",
        "max_review_rounds",
        "max_elapsed_seconds",
        "max_cost_units",
        "cost_unit"
      ],
      "properties": {
        "max_retries": {"type": "integer", "minimum": 0, "maximum": 100},
        "max_delegation_depth": {"type": "integer", "minimum": 0, "maximum": 16},
        "max_parallel_delegates": {"type": "integer", "minimum": 0, "maximum": 64},
        "max_review_rounds": {"type": "integer", "minimum": 0, "maximum": 20},
        "max_elapsed_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
        "max_cost_units": {"type": "number", "minimum": 0, "maximum": 1000000000},
        "cost_unit": {"type": "string", "minLength": 1, "maxLength": 40}
      }
    }
  },
  "examples": [
    {
      "schema_version": "1.0",
      "record_type": "TaskContract",
      "task_id": "TASK-001",
      "objective": "Получить один проверяемый результат в объявленном scope.",
      "acceptance_criteria": ["Результат подтверждён указанным evidence."],
      "constraints": ["Не выходить за owned_paths."],
      "non_goals": ["Не менять соседние подсистемы."],
      "owned_paths": ["standards/contracts/**"],
      "risk": {"level": "MEDIUM", "reasons": ["Меняется переносимый контракт."]},
      "required_evidence": ["Validator и unit tests завершились с exit 0."],
      "stop_conditions": ["Acceptance закрыт или требуется новое полномочие."],
      "capability_profile_ref": "capability-profile:TASK-001",
      "provenance_requirements": ["Фиксировать actual model из runtime либо UNKNOWN."],
      "requested_model": "UNKNOWN",
      "budgets": {
        "max_retries": 2,
        "max_delegation_depth": 1,
        "max_parallel_delegates": 1,
        "max_review_rounds": 2,
        "max_elapsed_seconds": 3600,
        "max_cost_units": 100,
        "cost_unit": "controller-defined"
      }
    }
  ]
}
