{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pro-qa-ai:contracts:handoff-contract:1.0",
  "title": "HandoffContract",
  "description": "Самодостаточная запись передачи между исполнителями или сессиями.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "handoff_id",
    "task_id",
    "from_role",
    "to_role",
    "repo_revision",
    "current_state",
    "objective",
    "acceptance_criteria",
    "owned_paths",
    "non_goals",
    "decisions",
    "evidence_refs",
    "known_failures",
    "unresolved_questions",
    "next_action",
    "constraints",
    "stop_conditions",
    "budget_state",
    "requested_model",
    "actual_model",
    "actual_model_evidence",
    "provenance_record_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "HandoffContract"},
    "handoff_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "from_role": {"type": "string", "minLength": 1},
    "to_role": {"type": "string", "minLength": 1},
    "repo_revision": {"type": "string", "pattern": "^(UNKNOWN|[0-9a-fA-F]{40,64})$"},
    "current_state": {
      "enum": ["NOT_STARTED", "IN_PROGRESS", "BLOCKED", "READY_FOR_VERIFICATION", "COMPLETE"]
    },
    "objective": {"type": "string", "minLength": 1},
    "acceptance_criteria": {"$ref": "#/$defs/nonEmptyStrings"},
    "owned_paths": {"$ref": "#/$defs/nonEmptyStrings"},
    "non_goals": {"$ref": "#/$defs/nonEmptyStrings"},
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_refs": {"$ref": "#/$defs/nonEmptyStrings"},
    "known_failures": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1}
    },
    "unresolved_questions": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string", "minLength": 1}
    },
    "next_action": {"type": "string", "minLength": 1},
    "constraints": {"$ref": "#/$defs/nonEmptyStrings"},
    "stop_conditions": {"$ref": "#/$defs/nonEmptyStrings"},
    "budget_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["limits_ref", "retries_used", "delegation_depth", "review_rounds_used", "elapsed_seconds", "cost_units_used"],
      "properties": {
        "limits_ref": {"type": "string", "minLength": 1},
        "retries_used": {"type": "integer", "minimum": 0},
        "delegation_depth": {"type": "integer", "minimum": 0},
        "review_rounds_used": {"type": "integer", "minimum": 0},
        "elapsed_seconds": {"type": "integer", "minimum": 0},
        "cost_units_used": {"type": "number", "minimum": 0}
      }
    },
    "requested_model": {"type": "string", "minLength": 1},
    "actual_model": {"type": "string", "minLength": 1},
    "actual_model_evidence": {"type": ["string", "null"]},
    "provenance_record_ref": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"actual_model": {"const": "UNKNOWN"}},
        "required": ["actual_model"]
      },
      "then": {"properties": {"actual_model_evidence": {"const": null}}},
      "else": {"properties": {"actual_model_evidence": {"type": "string", "minLength": 1}}}
    }
  ],
  "examples": [
    {
      "schema_version": "1.0",
      "record_type": "HandoffContract",
      "handoff_id": "HANDOFF-TASK-001",
      "task_id": "TASK-001",
      "from_role": "implementer",
      "to_role": "verifier",
      "repo_revision": "UNKNOWN",
      "current_state": "READY_FOR_VERIFICATION",
      "objective": "Проверить результат задачи.",
      "acceptance_criteria": ["Все обязательные проверки имеют evidence."],
      "owned_paths": ["standards/contracts/**"],
      "non_goals": ["Не менять файлы исполнителя."],
      "decisions": ["Использован vendor-neutral record format."],
      "evidence_refs": ["verification:pending"],
      "known_failures": [],
      "unresolved_questions": [],
      "next_action": "Выполнить независимую проверку.",
      "constraints": ["Verifier работает read-only."],
      "stop_conditions": ["Вердикт записан или найден blocker."],
      "budget_state": {
        "limits_ref": "task:TASK-001#budgets",
        "retries_used": 0,
        "delegation_depth": 1,
        "review_rounds_used": 0,
        "elapsed_seconds": 120,
        "cost_units_used": 2
      },
      "requested_model": "UNKNOWN",
      "actual_model": "UNKNOWN",
      "actual_model_evidence": null,
      "provenance_record_ref": "PROV-TASK-001"
    }
  ]
}
