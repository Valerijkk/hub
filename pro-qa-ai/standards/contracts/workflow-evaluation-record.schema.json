{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pro-qa-ai:contracts:workflow-evaluation-record:1.0",
  "title": "WorkflowEvaluationRecord",
  "description": "Запись реально запланированного/запущенного eval; не является runner и не доказывает эффективность сама по себе.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_type",
    "evaluation_id",
    "status",
    "comparison_design",
    "task_suite_revision",
    "baseline_workflow_revision",
    "candidate_workflow_revision",
    "requested_model",
    "actual_model",
    "actual_model_evidence",
    "budgets",
    "metrics",
    "observations",
    "evidence_refs",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "record_type": {"const": "WorkflowEvaluationRecord"},
    "evaluation_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["NOT_RUN", "RUNNING", "COMPLETE", "INVALID"]},
    "comparison_design": {"enum": ["SINGLE_ARM", "PAIRED", "MULTI_ARM"]},
    "task_suite_revision": {"$ref": "#/$defs/revision"},
    "baseline_workflow_revision": {"$ref": "#/$defs/revision"},
    "candidate_workflow_revision": {"$ref": "#/$defs/revision"},
    "requested_model": {"type": "string", "minLength": 1},
    "actual_model": {"type": "string", "minLength": 1},
    "actual_model_evidence": {"type": ["string", "null"]},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_runs", "max_elapsed_seconds", "max_cost_units", "cost_unit"],
      "properties": {
        "max_runs": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_elapsed_seconds": {"type": "integer", "minimum": 1, "maximum": 31536000},
        "max_cost_units": {"type": "number", "minimum": 0, "maximum": 1000000000},
        "cost_unit": {"type": "string", "minLength": 1}
      }
    },
    "metrics": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "unit", "value"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "value": {"type": ["number", "null"]}
        }
      }
    },
    "observations": {
      "type": "array",
      "maxItems": 10000,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 10000,
      "items": {"type": "string", "minLength": 1}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^(UNKNOWN|[0-9a-fA-F]{40,64})$"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "COMPLETE"}}, "required": ["status"]},
      "then": {
        "properties": {
          "metrics": {"minItems": 1},
          "observations": {"minItems": 1},
          "evidence_refs": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"actual_model": {"const": "UNKNOWN"}}, "required": ["actual_model"]},
      "then": {"properties": {"actual_model_evidence": {"const": null}}},
      "else": {"properties": {"actual_model_evidence": {"type": "string", "minLength": 1}}}
    }
  ],
  "examples": [
    {
      "schema_version": "1.0",
      "record_type": "WorkflowEvaluationRecord",
      "evaluation_id": "EVAL-001",
      "status": "NOT_RUN",
      "comparison_design": "SINGLE_ARM",
      "task_suite_revision": "UNKNOWN",
      "baseline_workflow_revision": "UNKNOWN",
      "candidate_workflow_revision": "UNKNOWN",
      "requested_model": "UNKNOWN",
      "actual_model": "UNKNOWN",
      "actual_model_evidence": null,
      "budgets": {"max_runs": 1, "max_elapsed_seconds": 3600, "max_cost_units": 100, "cost_unit": "controller-defined"},
      "metrics": [],
      "observations": [],
      "evidence_refs": [],
      "limitations": ["Измерение не запускалось; effectiveness не установлена."]
    }
  ]
}
