{
  "schema_version": 1,
  "inventory_path": "PACKAGE-INVENTORY.json",
  "provenance_gate": {
    "gsd_exact_revision": "UNKNOWN",
    "contains_substantial_copied_gsd_material": false,
    "attribution_paths": [
      "LICENSE",
      "NOTICE.md",
      "sources/PRIMARY-SOURCES.md"
    ]
  },
  "file_policy": {
    "allowed_text_extensions": [
      ".json",
      ".md",
      ".mdc",
      ".py",
      ".txt",
      ".yaml",
      ".yml"
    ],
    "allowed_text_names": [
      "LICENSE",
      ".gitignore"
    ],
    "max_file_bytes": 2097152,
    "max_total_bytes": 33554432,
    "max_file_count": 2000
  },
