{
  "schema_version": 1,
  "inventory_path": "PACKAGE-INVENTORY.json",
  "file_policy": {
    "allowed_text_extensions": [
      ".json",
      ".md",
      ".mdc",
      ".py",
      ".txt",
      ".yaml",
      ".yml"
    ],
    "allowed_text_names": [
      "LICENSE",
      ".gitignore"
    ],
    "max_file_bytes": 2097152,
    "max_total_bytes": 33554432,
    "max_file_count": 2000
  },
  "include_globs": [
    "agents/**",
    "skills/**",
    "rules/**",
    "playbooks/**",
    "prompts/**",
    "recipes/**",
    "practices/**",
    "sources/**",
    "docs/**",
    "scripts/validate_toolkit.py",
    "scripts/validation_manifest.json",
    "scripts/package_portable.py",
    "scripts/package_manifest.json",
    "scripts/safe_filesystem.py",
    "scripts/secret_rules.py",
    "scripts/context_inventory.py",
    "scripts/context_inventory_config.json",
    "scripts/context_inventory.schema.json",
    "scripts/tests/test_*.py",
    "context/*.md",
    "context/templates/**",
    "context/projects/README.md",
    "patterns/README.md",
    "patterns/SCHEMA.md",
    "patterns/CARD-TEMPLATE.md",
    "patterns/approved/README.md",
    "patterns/candidates/README.md",
    "review-feedback/TEMPLATE.md",
    "review-feedback/threads/README.md",
    "review-feedback/threads/THREAD-TEMPLATE.md",
    "review-feedback/threads/approved/**",
    "review-feedback/threads/inbox/README.md",
    "review-feedback/inbox/README.md",
    "review-feedback/approved/README.md",
    "VERSION.md",
    "MANIFEST.md",
    "CHANGELOG.md",
    "TOUCHSTONE.md",
    "COMMANDS.md",
    "README.md",
    "START-HERE.md",
    "INSTALL.md",
    "LICENSE",
    "NOTICE.md",
    "review-feedback/inbox/.gitignore",
    "planning/README.md",
    "planning/state/README.md",
    "planning/state/STATE.template.md",
    "planning/state/DECISIONS.template.md",
    "planning/backlog/README.md",
    "planning/backlog/TASK-TEMPLATE.md",
    "planning/bugs/README.md",
    "planning/bugs/BUG-TEMPLATE.md",
    "planning/discussions/README.md",
    "planning/discussions/DISCUSSION-TEMPLATE.md",
    "reasoning/README.md",
    "reasoning/REASONING-TEMPLATE.md"
  ],
  "exclude_with_allow_globs": [
    "context/projects/**",
    "patterns/approved/**",
    "patterns/candidates/**",
    "review-feedback/inbox/**",
    "review-feedback/threads/inbox/**",
    "review-feedback/approved/**"
  ],
  "exclude_globs": [
    "**/.git",
    "**/.git/**",
    "**/.hg",
    "**/.hg/**",
    "**/.svn",
    "**/.svn/**",
    "**/__pycache__",
    "**/__pycache__/**",
    "**/.pytest_cache",
    "**/.pytest_cache/**",
    "**/.mypy_cache",
    "**/.mypy_cache/**",
    "**/.ruff_cache",
    "**/.ruff_cache/**",
    "**/.cache",
    "**/.cache/**",
    "**/.hypothesis",
    "**/.hypothesis/**",
    "**/.tox",
    "**/.tox/**",
    "**/.nox",
    "**/.nox/**",
    "**/.venv",
    "**/.venv/**",
    "**/venv",
    "**/venv/**",
    "**/node_modules",
    "**/node_modules/**",
    "**/.env",
    "**/.env.*",
    "**/.envrc",
    "**/credentials.json",
    "**/credentials.*.json",
    "**/credentials.*",
    "**/service-account*.json",
    "**/secrets",
    "**/secrets/**",
    "**/secrets.*",
    "**/.netrc",
    "**/.npmrc",
    "**/.pypirc",
    "**/.docker/config.json",
    "**/kubeconfig",
    "**/*.kubeconfig",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/id_rsa",
    "**/id_ed25519",
    "**/*.pyc",
    "**/*.pyo",
    "**/.coverage",
    "**/.coverage.*",
    "**/htmlcov",
    "**/htmlcov/**",
    "**/*.log",
    "**/logs/**",
    "**/*.tmp",
    "**/*.temp",
    "**/*.bak",
    "**/*.swp",
    "**/*.swo",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/local-runs/**",
    "**/local-evidence/**",
    "**/run-evidence/**"
  ],
  "exclude_allow_globs": [
    "context/projects/README.md",
    "patterns/approved/README.md",
    "patterns/candidates/README.md",
    "review-feedback/inbox/README.md",
    "review-feedback/approved/README.md",
    "review-feedback/threads/inbox/README.md"
  ],
  "prune_globs": [
    "**/.git",
    "**/.hg",
    "**/.svn",
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.mypy_cache",
    "**/.ruff_cache",
    "**/.cache",
    "**/.hypothesis",
    "**/.tox",
    "**/.nox",
    "**/.venv",
    "**/venv",
    "**/node_modules",
    "**/htmlcov"
  ],
  "required_paths": [
    "agents",
    "skills",
    "rules",
    "playbooks",
    "prompts",
    "recipes",
    "practices",
    "sources",
    "docs",
    "scripts/validate_toolkit.py",
    "scripts/validation_manifest.json",
    "scripts/package_portable.py",
    "scripts/package_manifest.json",
    "scripts/safe_filesystem.py",
    "scripts/secret_rules.py",
    "scripts/context_inventory.py",
    "scripts/context_inventory_config.json",
    "scripts/context_inventory.schema.json",
    "scripts/tests/test_validate_toolkit.py",
    "scripts/tests/test_package_portable.py",
    "scripts/tests/test_safe_filesystem.py",
    "scripts/tests/test_context_inventory.py",
    "context/README.md",
    "context/templates",
    "context/projects/README.md",
    "patterns/README.md",
    "patterns/SCHEMA.md",
    "patterns/CARD-TEMPLATE.md",
    "patterns/approved/README.md",
    "patterns/candidates/README.md",
    "review-feedback/TEMPLATE.md",
    "review-feedback/threads/README.md",
    "review-feedback/threads/THREAD-TEMPLATE.md",
    "review-feedback/threads/approved/README.md",
    "review-feedback/threads/inbox/README.md",
    "review-feedback/inbox/README.md",
    "review-feedback/approved/README.md",
    "VERSION.md",
    "MANIFEST.md",
    "CHANGELOG.md",
    "TOUCHSTONE.md",
    "COMMANDS.md",
    "README.md",
    "START-HERE.md",
    "INSTALL.md",
    "LICENSE",
    "NOTICE.md",
    "planning/README.md",
    "reasoning/README.md"
  ]
}
